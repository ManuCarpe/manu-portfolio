---
// Two short sub-sections side by side, e.g. "The kid" | "The parent".
//   <Pair>
//     <Section level={3} title="The kid">…</Section>
//     <Section level={3} title="The parent">…</Section>
//   </Pair>
---

<div class="pair"><slot /></div>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 25px;
    row-gap: 48px;
    align-items: start;
  }
  @media (max-width: 1023px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
