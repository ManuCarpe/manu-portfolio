---
// A case study chapter: a white block with the heading on the left and the text on the right
// (Figma "section2", 1667px wide at 3008). Listed in the side panel's Index.
//
//   <Section title="What Drip is">
//     <Lead>…</Lead>                     the black takeaway line
//     Body text…
//     <Split slot="after">…</Split>      anything full width underneath: <Split>, <Quote>,
//   </Section>                           <Feature>, <Wide>, an image (all with slot="after")
import { slugify } from '../../lib/slug';

interface Props {
  title: string;
  /** false = leave this chapter out of the side panel's Index */
  index?: boolean;
}
const { title, index = true } = Astro.props;
const id = slugify(title);
const hasAfter = Astro.slots.has('after');
---

<section class="chapter" id={id} data-nav={index ? id : undefined}>
  <div class="chapter__head">
    <h2 class="chapter__title display">{title}</h2>
    <div class="chapter__body">
      <slot />
    </div>
  </div>
  {hasAfter && (
    <div class="chapter__after">
      <slot name="after" />
    </div>
  )}
</section>

<style>
  .chapter {
    background: #fff;
    padding: max(32px, calc(117 * var(--cu))) max(16px, calc(101 * var(--cu)));
    scroll-margin-top: 140px;
  }
  /* thin line between two chapters that follow each other */
  :global(.chapter + .chapter) {
    border-top: 1px solid var(--bg);
  }
  .chapter__head {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: calc(39 * var(--cu));
    align-items: start;
  }
  .chapter__title {
    font-size: max(30px, calc(67 * var(--cu)));
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .chapter__body,
  .chapter__after {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .chapter__body {
    gap: max(20px, calc(51 * var(--cu)));
  }
  .chapter__after {
    gap: max(24px, calc(64 * var(--cu)));
    margin-top: max(28px, calc(64 * var(--cu)));
  }

  /* Body copy everywhere in the case study (Barlow Medium 22 at 3008) */
  .chapter :global(:where(p)) {
    font-family: var(--sans);
    font-size: max(15px, calc(22 * var(--cu)));
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: #565a5b;
  }
  .chapter :global(:where(p) strong) {
    color: var(--text);
    font-weight: 500;
  }
  .chapter :global(:where(p) a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .chapter__head {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }
  }
</style>
