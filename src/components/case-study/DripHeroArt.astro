---
// Drip hero artwork layered over the family photo (Figma "section1" 217:2738):
// Drip logo, floating coin and drop, and the phone rising from the bottom edge.
// Coordinates are Figma pixels in the 1667 × 1415 hero (--k = 1 Figma px).
import { Image } from 'astro:assets';
import logo from '../../assets/case-studies/drip/v3/drip-logo.png';
import coin from '../../assets/case-studies/drip/v3/coin.png';
import drop from '../../assets/case-studies/drip/v3/drop.png';
import phone from '../../assets/case-studies/drip/v4/hero-phone.png';
---

<Image class="art art--logo" src={logo} alt="Drip" widths={[208, 390]} sizes="(max-width: 1023px) 60px, 9vw" />
<Image class="art art--phone" src={phone} alt="The Drip investment options screen on a phone" widths={[410, 820, 1231]} sizes="(max-width: 1023px) 40vw, 21vw" />
<Image class="art art--coin" src={coin} alt="" widths={[200, 393, 590]} sizes="(max-width: 1023px) 25vw, 13vw" />
<Image class="art art--drop" src={drop} alt="" widths={[140, 278, 417]} sizes="(max-width: 1023px) 18vw, 9vw" />

<style>
  .art {
    position: absolute;
    height: auto;
    max-width: none;
  }
  .art--logo {
    left: calc(729 * var(--k));
    top: calc(141 * var(--k));
    width: calc(208 * var(--k));
    z-index: 2;
  }
  .art--phone {
    left: calc(628 * var(--k));
    bottom: 0;
    width: calc(410 * var(--k));
    z-index: 3;
  }
  .art--coin {
    left: max(calc(-67 * var(--k)), -16px);
    top: calc(516 * var(--k));
    width: calc(271 * var(--k));
    z-index: 4;
    animation: float 7s ease-in-out infinite;
  }
  .art--drop {
    left: calc(1220 * var(--k));
    top: calc(-46 * var(--k));
    width: calc(202 * var(--k));
    z-index: 4;
    animation: float 6s ease-in-out -2s infinite reverse;
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    50% {
      translate: 0 calc(-18 * var(--k));
      rotate: -5deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .art--coin,
    .art--drop {
      animation: none;
    }
  }
</style>
