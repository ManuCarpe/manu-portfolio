---
// A full-width image. Leave out `src` for a grey placeholder.
//   <Wide src={img} alt="…" />
//   <Wide src={img} caption="Datadog session replays…" />   white label in the top-left corner
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  /** placeholder shape, width / height */
  ratio?: number;
}
const { src, alt = '', caption, ratio = 1667 / 636 } = Astro.props;
const widths = src ? [800, 1200, 1667, 2080].filter((w) => w <= src.width) : [];
---

{
  src && caption ? (
    <figure class="wide wide--cap">
      <Image class="wide__img" src={src} alt={alt} widths={widths} sizes="(max-width: 1023px) 100vw, 56vw" />
      <figcaption class="wide__cap">{caption}</figcaption>
    </figure>
  ) : src ? (
    <Image class="wide" src={src} alt={alt} widths={widths} sizes="(max-width: 1023px) 100vw, 56vw" />
  ) : (
    <div class="wide wide--empty" style={`aspect-ratio:${ratio}`} role="img" aria-label={alt || 'Image coming soon'} />
  )
}

<style>
  .wide {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  .wide--empty {
    background: var(--placeholder);
  }
  .wide--cap {
    position: relative;
    container-type: inline-size;
  }
  .wide__img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Barlow Medium 18 on a 914px-wide image at 1440 */
  .wide__cap {
    position: absolute;
    left: calc(28 / 914 * 100cqw);
    top: calc(19 / 914 * 100cqw);
    max-width: calc(270 / 914 * 100cqw);
    font-family: var(--sans);
    font-weight: 500;
    font-size: max(12px, calc(18.25 / 914 * 100cqw));
    line-height: 1.17;
    letter-spacing: -0.01em;
    color: #fff;
  }
</style>
