---
// A full-width image between sections. Leave out `src` for a grey placeholder.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** placeholder shape, width / height */
  ratio?: number;
}
const { src, alt = '', ratio = 1667 / 636 } = Astro.props;
---

{
  src ? (
    <Image class="wide" src={src} alt={alt} widths={[800, 1200, 1667].filter((w) => w <= src.width)} sizes="(max-width: 1023px) 100vw, 56vw" />
  ) : (
    <div class="wide wide--empty" style={`aspect-ratio:${ratio}`} role="img" aria-label={alt || 'Image coming soon'} />
  )
}

<style>
  .wide {
    display: block;
    width: 100%;
    height: auto;
  }
  .wide--empty {
    background: var(--placeholder);
  }
</style>
