---
import { Image } from 'astro:assets';
import photo from '../../assets/case-studies/drip/anim/invite-photo.png';
import avatar from '../../assets/case-studies/drip/anim/invite-avatar.png';

// "Request sent !" frame from Figma, rebuilt live: the invite notification pops up
// over the photo, holds, fades away and comes back. Coordinates are Figma pixels
// inside the 822 × 293 frame.
interface Props {
  name?: string;
  message?: string;
}
const { name = 'Charlotte', message = 'Request sent !' } = Astro.props;
---

<figure class="invite" aria-label={`A teen sending her parent an invite from her phone: ${message}`}>
  <Image class="photo" src={photo} alt="" widths={[822]} sizes="(max-width: 1023px) calc(100vw - 32px), 40vw" />
  <div class="toast" aria-hidden="true">
    <div class="toast__inner">
      <p class="toast__title">{message}</p>
      <p class="toast__who">
        <Image class="toast__avatar" src={avatar} alt="" widths={[41]} />
        <span>{name}</span>
      </p>
    </div>
  </div>
</figure>

<style>
  .invite {
    --k: calc(100cqw / 822); /* 1 Figma px */
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 822 / 293;
    overflow: hidden;
    container-type: inline-size;
    background: #6dbcf1;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Card rotated 19° like the Figma group, anchored at its top-left corner */
  .toast {
    position: absolute;
    left: calc(116 * var(--k));
    top: calc(146 * var(--k));
    min-width: calc(158 * var(--k));
    min-height: calc(83 * var(--k));
    transform: rotate(-19deg);
    transform-origin: 0 0;
  }
  .toast__inner {
    min-width: inherit;
    min-height: inherit;
    padding: calc(14 * var(--k)) calc(14 * var(--k)) calc(12 * var(--k));
    white-space: nowrap;
    border-radius: calc(10 * var(--k));
    background: rgba(109, 188, 241, 0.9);
    -webkit-backdrop-filter: blur(12.5px);
    backdrop-filter: blur(12.5px);
    color: #fff;
    font-family: var(--sans);
    animation: toast 5.5s cubic-bezier(0.3, 0.7, 0.2, 1) infinite;
    transform-origin: 30% 100%;
  }
  .toast__title {
    font-size: calc(22 * var(--k));
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.86);
  }
  .toast__who {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--k));
    margin-top: calc(10 * var(--k));
    font-size: calc(13 * var(--k));
    color: rgba(255, 255, 255, 0.6);
  }
  .toast__avatar {
    width: calc(21 * var(--k));
    height: calc(21 * var(--k));
  }

  /* Pop up from the phone, hold, drift away, repeat */
  @keyframes toast {
    0%,
    8% {
      opacity: 0;
      transform: translateY(calc(40 * var(--k))) scale(0.85);
    }
    18% {
      opacity: 1;
      transform: translateY(calc(-3 * var(--k))) scale(1.02);
    }
    24%,
    78% {
      opacity: 1;
      transform: none;
    }
    90%,
    100% {
      opacity: 0;
      transform: translateY(calc(-14 * var(--k))) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast__inner {
      animation: none;
    }
  }
</style>
