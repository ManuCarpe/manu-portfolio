---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// An image in a case study. Leave out `src` to show a grey placeholder until the screen is ready.
interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Placeholder shape, width / height. Defaults to the Figma screen slot (523 × 261). */
  ratio?: number;
}
const { src, alt = '', ratio = 523.2 / 261 } = Astro.props;
---

{
  src ? (
    <Image
      class="shot"
      src={src}
      alt={alt}
      widths={[480, 820, 1200, 1640].filter((w) => w <= src.width)}
      sizes="(max-width: 1023px) calc(100vw - 32px), 40vw"
    />
  ) : (
    <div class="shot placeholder" style={`aspect-ratio:${ratio}`} role="img" aria-label={alt || 'Image coming soon'} />
  )
}

<style>
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .placeholder {
    background: var(--placeholder);
  }
</style>
