---
// A wide lavender card with a small note and a big faint headline on the left (Figma 223:5540).
//   <Feature slot="after" src={img} alt="…" note="In July 2025, …" title="A mission scaling, not ending." />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  note?: string;
  title: string;
}
const { src, alt = '', note, title } = Astro.props;
---

<figure class="feature">
  <Image class="feature__img" src={src} alt={alt} widths={[1000, 2198].filter((w) => w <= src.width)} sizes="(max-width: 1023px) 100vw, 48vw" />
  <figcaption class="feature__text">
    {note && <span class="feature__note">{note}</span>}
    <span class="feature__title">{title}</span>
  </figcaption>
</figure>

<style>
  .feature {
    --k: calc(100cqw / 1465);
    position: relative;
    margin: 0;
    aspect-ratio: 1465 / 398;
    min-height: 220px;
    container-type: inline-size;
    overflow: hidden;
    border-radius: max(16px, calc(44.9 * var(--k)));
    background: #fcf8ff;
  }
  .feature__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .feature__text {
    position: absolute;
    left: calc(43 * var(--k));
    top: calc(35 * var(--k));
    bottom: calc(36 * var(--k));
    width: max(150px, calc(300 * var(--k)));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: rgba(95, 51, 130, 0.37);
  }
  .feature__note {
    font-size: max(10px, calc(16 * var(--k)));
    line-height: 1.2;
  }
  .feature__title {
    font-size: max(20px, calc(50 * var(--k)));
    line-height: 0.85;
  }
  /* Phones: the note and headline sit above the photo instead of on top of it */
  @media (max-width: 767px) {
    .feature {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding-top: 20px;
    }
    .feature__text {
      position: static;
      width: auto;
      gap: 14px;
      padding: 0 20px;
    }
    .feature__img {
      position: static;
      height: 260px;
      object-position: 88% 30%;
    }
  }
</style>
