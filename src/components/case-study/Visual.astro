---
// An image card in the left column of a <Split>, with its label in a corner.
//   <Visual src={img} caption="Celebration, not anxiety" />                    lavender Drip card
//   <Visual src={img} caption="…" captionAt="bottom" />                        label bottom-left
//   <Visual tone="dark" src={img} caption="Real-time weather" captionAt="bottom" />  dark product card
// The card takes the shape of its image. Anything inside <Visual>…</Visual> is layered on top;
// it can size itself with --k = 1 Figma px of the card (681 wide for lavender, 425 for dark).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  captionAt?: 'top' | 'bottom';
  tone?: 'lavender' | 'dark';
}
const { src, alt = '', caption, captionAt = 'top', tone = 'lavender' } = Astro.props;

// Card width in Figma px and corner radius for each style
const base = tone === 'dark' ? 425 : 681;
const radius = tone === 'dark' ? 19.8 : 44.9;
const height = (base * src.height) / src.width;
// Corners as percentages of the card itself (container units would measure the page column)
const corners = `${((radius / base) * 100).toFixed(3)}% / ${((radius / height) * 100).toFixed(3)}%`;
---

<figure
  class:list={['visual', `visual--${tone}`]}
  style={`--base:${base};aspect-ratio:${src.width} / ${src.height};border-radius:${corners}`}
>
  <Image class="visual__img" src={src} alt={alt} widths={[base, base * 2].filter((w) => w <= src.width)} sizes="(max-width: 1023px) 100vw, 28vw" />
  {caption && <figcaption class:list={['cap', tone === 'lavender' && 'cs-cap', `cap--${captionAt}`]}>{caption}</figcaption>}
  <slot />
</figure>

<style>
  .visual {
    --k: calc(100cqw / var(--base));
    position: relative;
    margin: 0;
    width: 100%;
    container-type: inline-size;
    overflow: hidden;
  }
  .visual--dark {
    background: #41494c;
  }
  .visual__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cap {
    position: absolute;
    z-index: 20;
  }

  /* Lavender (Drip): faint purple label */
  .visual--lavender .cap {
    left: calc(32 * var(--k));
    max-width: calc(200 * var(--k));
  }
  .visual--lavender .cap--top {
    top: calc(31 * var(--k));
  }
  .visual--lavender .cap--bottom {
    bottom: calc(34 * var(--k));
  }

  /* Dark (product screens): white label, Barlow Bold 14 at 1440 */
  .visual--dark .cap {
    left: calc(22 * var(--k));
    max-width: calc(180 * var(--k));
    margin: 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: max(10px, calc(14 * var(--k)));
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .visual--dark .cap--top {
    top: calc(21 * var(--k));
  }
  .visual--dark .cap--bottom {
    bottom: calc(19 * var(--k));
  }
</style>
