---
// "Investment options as themes, not SKUs." card (Figma 223:5360), rebuilt live: the theme
// cards shuffle one place to the right every few seconds across the phone, and the card that
// lands in the middle grows (Battery Tech → Emerging Markets → Asia 200 …).
// Coordinates are Figma pixels of the 681 × 398 card (--k = 1 Figma px).
import { Image } from 'astro:assets';
import bg from '../../assets/case-studies/drip/v4/card-options.png';
import phone from '../../assets/case-studies/drip/v4/options-phone.png';
import usa500 from '../../assets/case-studies/drip/anim/card-usa-500.png';
import asia200 from '../../assets/case-studies/drip/anim/card-asia-200.png';
import emerging from '../../assets/case-studies/drip/anim/card-emerging-markets.png';
import battery from '../../assets/case-studies/drip/anim/card-battery-tech.png';
import cyber from '../../assets/case-studies/drip/anim/card-cyber-security.png';
import crypto from '../../assets/case-studies/drip/anim/card-crypto.png';
import commodities from '../../assets/case-studies/drip/anim/card-commodities.png';

const cards = [
  { src: usa500, label: 'USA 500' },
  { src: asia200, label: 'Asia 200' },
  { src: emerging, label: 'Emerging Markets' },
  { src: battery, label: 'Battery Tech' },
  { src: cyber, label: 'Cyber Security' },
  { src: crypto, label: 'Crypto' },
  { src: commodities, label: 'Commodities' },
];
const START = 3; // Battery Tech in the middle, as in the design

// Offset from the middle → card centre x (neighbours 110px away, then 100px apart).
// Mirrored in the script below.
const centreX = (o: number) => {
  const a = Math.abs(o);
  return 340.5 + Math.sign(o) * (a === 0 ? 0 : 110 + (a - 1) * 100);
};

interface Props {
  /** Seconds each card stays in the middle */
  interval?: number;
  caption?: string;
}
const { interval = 2.6, caption = 'Investment options as themes, not SKUs.' } = Astro.props;
---

<figure
  class="options"
  data-options
  data-interval={interval}
  aria-label="Drip investment options screen with theme cards (USA 500, Asia 200, Emerging Markets, Battery Tech, Cyber Security, Crypto, Commodities) shuffling across the phone"
>
  <Image class="bg" src={bg} alt="" widths={[681, 1362]} sizes="(max-width: 1023px) 100vw, 28vw" />
  <figcaption class="cap cs-cap">{caption}</figcaption>
  <Image class="phone" src={phone} alt="" widths={[308, 616]} sizes="(max-width: 1023px) 25vw, 8vw" />
  <div class="row" aria-hidden="true">
    {cards.map((c, i) => (
      <div
        class="card"
        data-card
        style={`--o:${i - START};--x:${centreX(i - START)};--s:${i === START ? 1.2 : 1};z-index:${10 - Math.abs(i - START)}`}
      >
        <Image src={c.src} alt="" widths={[200, 336]} sizes="(max-width: 1023px) 25vw, 8vw" />
      </div>
    ))}
  </div>
</figure>

<script>
  const centreX = (o: number) => {
    const a = Math.abs(o);
    return 340.5 + Math.sign(o) * (a === 0 ? 0 : 110 + (a - 1) * 100);
  };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-options]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const half = Math.floor(cards.length / 2);
    let offsets = cards.map((c) => parseInt(c.style.getPropertyValue('--o'), 10));

    const place = (card: HTMLElement, o: number) => {
      card.style.setProperty('--x', String(centreX(o)));
      card.style.setProperty('--s', o === 0 ? '1.2' : '1');
      card.style.zIndex = String(10 - Math.abs(o));
    };

    const step = () => {
      // The card on the far right jumps (hidden by the edge fade) to just off the left edge…
      cards.forEach((c, i) => {
        if (offsets[i] === half) {
          c.classList.add('jump');
          offsets[i] = -half - 1;
          place(c, offsets[i]);
          void c.offsetWidth;
          c.classList.remove('jump');
        }
      });
      // …then everything slides one place right; the new middle card grows
      offsets = offsets.map((o) => o + 1);
      cards.forEach((c, i) => place(c, offsets[i]));
    };

    let timer: number | undefined;
    const ms = parseFloat(root.dataset.interval || '2.6') * 1000;
    const start = () => {
      if (timer || reduce.matches) return;
      timer = window.setInterval(step, ms);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    let visible = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible && !document.hidden ? start() : stop();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (visible && !document.hidden ? start() : stop()));
  });
</script>

<style>
  .options {
    --k: calc(100cqw / 681); /* 1 Figma px */
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 681 / 398;
    container-type: inline-size;
    overflow: hidden;
    border-radius: calc(44.9 * var(--k));
    background: #f6eefb;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cap {
    position: absolute;
    left: calc(32 * var(--k));
    top: calc(31 * var(--k));
    max-width: calc(190 * var(--k));
  }
  .phone {
    position: absolute;
    left: calc(260 * var(--k));
    top: calc(151 * var(--k));
    width: calc(161 * var(--k));
    height: auto;
  }
  /* The row of theme cards, faded out at the sides */
  .row {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }
  .card {
    --x: 0;
    --s: 1;
    position: absolute;
    left: 0;
    top: calc(230.5 * var(--k));
    width: calc(94 * var(--k));
    height: calc(99.7 * var(--k));
    transform: translateX(calc((var(--x) - 47) * var(--k))) scale(var(--s));
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.25, 1);
    will-change: transform;
  }
  .card.jump {
    transition: none;
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
