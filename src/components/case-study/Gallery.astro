---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Full-width rows of images. Images in the same row share one height
// (each takes width in proportion to its shape), 16px apart — as in the Figma brand gallery.
//   <Gallery rows={[[wide], [left, right]]} />
interface Props {
  rows: { src: ImageMetadata; alt?: string }[][];
}
const { rows } = Astro.props;
---

<div class="gallery">
  {rows.map((row) => (
    <div class="row">
      {row.map(({ src, alt = '' }) => (
        <div class="cell" style={`flex:${src.width / src.height}`}>
          <Image
            src={src}
            alt={alt}
            widths={[480, 820, 1200, 1667].filter((w) => w <= src.width)}
            sizes={`(max-width: 1023px) calc(100vw - 32px), ${Math.round(56 / row.length)}vw`}
          />
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .row {
    display: flex;
    gap: 16px;
  }
  .cell {
    min-width: 0;
  }
  .cell img {
    width: 100%;
    height: auto;
  }
  @media (max-width: 1023px) {
    .gallery,
    .row {
      gap: 8px;
    }
  }
</style>
