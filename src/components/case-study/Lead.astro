---
// The black takeaway line inside a section (24px medium in Figma).
interface Props {
  size?: 'normal' | 'large';
}
const { size = 'normal' } = Astro.props;
---

<p class:list={['lead', { large: size === 'large' }]}><slot /></p>

<style>
  .lead {
    color: var(--text);
    font-family: var(--sans);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .large {
    font-size: 32px;
  }
  @media (max-width: 1023px) {
    .lead {
      font-size: 19px;
    }
    .large {
      font-size: 22px;
    }
  }
</style>
