---
// Text whose letters rise into place once, when the home page first loads.
// The page holds them down while html has the `intro-wait` class (see index.astro); the home
// page script then lifts them, one after another, using each letter's --d delay.
//   <RiseText text="Manu Mackal" start={0.4} />
interface Props {
  text: string;
  /** seconds before the first letter moves */
  start?: number;
  /** seconds between letters */
  step?: number;
}
const { text, start = 0, step = 0.03 } = Astro.props;
let k = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, d: (start + k++ * step).toFixed(3) })));
---

<span class="sr-only">{text}</span><span class="rise" aria-hidden="true">{words.map((w, i) => (
  <Fragment>{i > 0 && ' '}<span class="w">{w.map((c) => <span class="ch" style={`--d:${c.d}s`}>{c.ch}</span>)}</span></Fragment>
))}</span>

<style>
  .rise {
    display: inline-block;
    /* letters come up from just below their baseline */
    clip-path: inset(-0.6em -0.3em -0.3em -0.3em);
  }
  .w {
    display: inline-block;
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
  }
  :global(html.intro-wait) .ch {
    transform: translateY(1.45em);
  }
</style>
