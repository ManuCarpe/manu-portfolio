---
// The Playground: an endless canvas of work. Drag (or swipe) to move around; it keeps
// gliding after you let go, with a motion blur that follows the speed. The edges of the
// screen are softly blurred. Pieces and their animations come from src/data/playground.ts.
//
// The server renders one tile (three columns); the script clones it as many times as
// needed to fill the screen and wraps it around as you move.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ANIM, frames, tile } from '../data/playground';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/playground-v4/*.png', { eager: true });
const img = (k: string) => files[`../assets/playground-v4/${k}.png`]?.default;

// Lay the frames out into three columns, each piece going to the shortest column
type Piece = { k: string; y: number; h: number; W: number; H: number };
const cols: { x: number; pieces: Piece[]; end: number }[] = Array.from({ length: tile.cols }, (_, i) => ({
  x: i * tile.colGap,
  pieces: [],
  end: 0,
}));
for (const k of Object.keys(frames).sort()) {
  const a = ANIM[k];
  if (!img(k) && !(a?.scroll && img(`${k}-long`))) continue;
  const [W, H] = frames[k];
  const h = Math.round((tile.card * H) / W);
  const c = cols.reduce((m, c) => (c.end < m.end ? c : m));
  c.pieces.push({ k, y: c.end, h, W, H });
  c.end += h + tile.gap;
}
const tileW = tile.cols * tile.colGap + 1;
// Position helpers: Figma px inside a frame → % of the card
const box = (r: number[], W: number, H: number) =>
  `left:${(r[0] / W) * 100}%;top:${(r[1] / H) * 100}%;width:${(r[2] / W) * 100}%;height:${(r[3] / H) * 100}%`;
const px = (r: number[], W: number) => Math.min(1600, Math.round((r[2] / W) * 654));
let n = 0;
---
<div class="canvas" data-canvas data-tile-w={tileW} aria-label="Playground — drag to explore" role="region">
  <div class="canvas__world" data-world>
    <template data-tile>
      {cols.map((c) => (
        <div class="col" data-col style={`left:${c.x}px`} data-period={c.end}>
          <div class="col__run" data-run>
            {c.pieces.map(({ k, y, h, W, H }) => {
              const a = ANIM[k] ?? {};
              const base = img(k);
              const long = a.scroll && img(`${k}-long`);
              const s = a.scroll;
              return (
                <div class:list={['piece', a && Object.keys(a).length && 'piece--anim']} data-anim style={`top:${y}px;height:${h}px;--i:${n++ % 7}`}>
                  {long && s ? (
                    <Image class="lyr scroll" src={long} alt="" width={px(s, W)} loading="lazy" decoding="async" draggable="false"
                      style={`${box(s, W, H)};top:0;--sy:${-(1 - H / s[3]) * 100}%`} />
                  ) : base && (
                    <Image class="piece__img" src={base} alt="" widths={[240, 480, 654]}
                      sizes="(max-width: 1023px) 110px, (max-width: 2200px) 132px, 220px" loading="lazy" decoding="async" draggable="false" />
                  )}
                  {a.layers?.map(([key, ...r]) => {
                    const src = img(`${k}-${key}`);
                    const [x, yy, w, hh, fx, d] = r as [number, number, number, number, string, number];
                    return src && (fx === 'marquee' ? (
                      <div class="lyr marquee" style={box([x, yy, w, hh], W, H)}>
                        <div class="marquee__track">
                          <Image src={src} alt="" width={px([0, 0, w], W)} loading="lazy" draggable="false" />
                          <Image src={src} alt="" width={px([0, 0, w], W)} loading="lazy" draggable="false" />
                        </div>
                      </div>
                    ) : (
                      <Image class={`lyr fx-${fx}`} src={src} alt="" width={px([0, 0, w], W)} loading="lazy" decoding="async" draggable="false"
                        style={`${box([x, yy, w, hh], W, H)};--d:${d}s`} />
                    ));
                  })}
                  {a.pulses?.map((r, i) => <i class="fx pulse" style={`${box(r, W, H)};--d:${i * 0.6}s`} />)}
                  {a.dots?.map((r, i) => <i class="fx dot" style={`${box(r, W, H)};--d:${i * 0.45}s`} />)}
                  {a.glow?.map((r) => <i class="fx glow" style={box(r, W, H)} />)}
                  {a.rows?.map((r, i) => <i class="fx row" style={`${box(r, W, H)};--d:${i * 1.1}s`} />)}
                  {a.rings && [0, 1, 2].map((i) => {
                    const [cx, cy, R] = a.rings!;
                    return <i class="fx ring" style={`${box([cx - R, cy - R, R * 2, R * 2], W, H)};--d:${i * 1.6}s`} />;
                  })}
                  {a.sheen && <i class="fx sheen" />}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </template>
  </div>

  <!-- Soft, progressively blurred edges -->
  <div class="edge edge--l" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="edge edge--r" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="edge edge--b" aria-hidden="true"><i></i><i></i><i></i></div>

  <p class="hint" aria-hidden="true">Drag to explore</p>
</div>

<style>
  .canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Soft top edge while the playground slides in (set by the home page script) */
  .canvas {
    --fade: 0vh;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade));
    mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade));
  }
  .canvas.is-dragging {
    cursor: grabbing;
  }
  .canvas__world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform, filter;
  }
  .canvas__world :global(.col) {
    position: absolute;
    top: 0;
    width: 218px;
  }
  .canvas__world :global(.col__run) {
    position: absolute;
    left: 0;
    top: 0;
    width: 218px;
  }
  .canvas__world :global(.piece) {
    position: absolute;
    left: 0;
    width: 218px;
    overflow: hidden;
    pointer-events: none;
    contain: layout paint;
  }
  .canvas__world :global(.piece img) {
    -webkit-user-drag: none;
  }
  .canvas__world :global(.piece__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .canvas__world :global(.lyr),
  .canvas__world :global(.fx) {
    position: absolute;
    display: block;
  }

  /* ---------- Piece animations (play only while the piece is on screen: .on) ---------- */
  .canvas__world :global(.piece--anim *) {
    animation-play-state: paused !important;
  }
  .canvas__world :global(.piece--anim.on *) {
    animation-play-state: running !important;
  }
  /* Long page scrolling inside its frame, then back up */
  .canvas__world :global(.scroll) {
    max-width: none;
    animation: pg-scroll 22s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes pg-scroll {
    0%, 8% { transform: translateY(0); }
    46%, 54% { transform: translateY(var(--sy)); }
    92%, 100% { transform: translateY(0); }
  }
  /* Layers: 7s loop — come in, hold, leave */
  .canvas__world :global(.fx-reveal) {
    animation: pg-reveal 7s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes pg-reveal {
    0% { clip-path: circle(0% at 50% 72%); opacity: 0; }
    10% { opacity: 1; }
    45%, 85% { clip-path: circle(80% at 50% 72%); opacity: 1; }
    95%, 100% { clip-path: circle(80% at 50% 72%); opacity: 0; }
  }
  .canvas__world :global(.fx-rise) {
    animation: pg-rise 7s cubic-bezier(0.22, 1, 0.36, 1) var(--d) infinite backwards;
  }
  @keyframes pg-rise {
    0% { transform: translateY(18%); opacity: 0; }
    12%, 80% { transform: none; opacity: 1; }
    92%, 100% { transform: translateY(-10%); opacity: 0; }
  }
  .canvas__world :global(.fx-pop) {
    transform-origin: 50% 100%;
    animation: pg-pop 7s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) infinite backwards;
  }
  @keyframes pg-pop {
    0% { transform: scale(0.6) translateY(12%); opacity: 0; }
    10%, 80% { transform: none; opacity: 1; }
    90%, 100% { transform: scale(0.9); opacity: 0; }
  }
  /* Card stack: cards roll in from the back, one after another, then roll away */
  .canvas__world :global(.fx-roll) {
    transform-origin: 50% 0;
    animation: pg-roll 6s cubic-bezier(0.22, 1, 0.36, 1) var(--d) infinite backwards;
  }
  @keyframes pg-roll {
    0% { transform: perspective(600px) translateY(40%) rotateX(-70deg); opacity: 0; }
    14%, 74% { transform: none; opacity: 1; }
    88%, 100% { transform: perspective(600px) translateY(-30%) rotateX(50deg); opacity: 0; }
  }
  /* Two states of a component, cross-fading (Figma smart animate, 1.25s) */
  .canvas__world :global(.fx-swapA) { animation: pg-swap 5s ease-in-out infinite; }
  .canvas__world :global(.fx-swapB) { animation: pg-swap 5s ease-in-out -2.5s infinite; }
  @keyframes pg-swap {
    0%, 37% { opacity: 1; transform: none; }
    50%, 87% { opacity: 0; transform: scale(0.97); }
    100% { opacity: 1; transform: none; }
  }
  /* Very slow marquee */
  .canvas__world :global(.marquee) {
    overflow: hidden;
  }
  .canvas__world :global(.marquee__track) {
    display: flex;
    width: 200%;
    height: 100%;
    animation: pg-marquee 60s linear infinite;
  }
  .canvas__world :global(.marquee__track img) {
    width: 50%;
    height: 100%;
    max-width: none;
  }
  @keyframes pg-marquee {
    to { transform: translateX(-50%); }
  }
  /* CSS-only accents */
  .canvas__world :global(.pulse) {
    border: 1.5px solid rgb(140 255 220 / 0.8);
    border-radius: 50%;
    animation: pg-pulse 2.4s ease-out var(--d) infinite backwards;
  }
  @keyframes pg-pulse {
    0% { transform: scale(0.3); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  .canvas__world :global(.dot) {
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgb(120 255 210 / 0.6);
    animation: pg-dot 2.7s ease-out var(--d) infinite;
  }
  @keyframes pg-dot {
    0% { box-shadow: 0 0 0 0 rgb(120 255 210 / 0.55); }
    80%, 100% { box-shadow: 0 0 0 10px rgb(120 255 210 / 0); }
  }
  .canvas__world :global(.glow) {
    border-radius: 8px;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%) -200% 0 / 200% 100% no-repeat;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25), 0 0 24px rgb(160 140 255 / 0.35);
    mix-blend-mode: screen;
    animation: pg-glow 3.6s ease-in-out infinite;
  }
  @keyframes pg-glow {
    0% { background-position: -200% 0; opacity: 0.35; }
    50% { opacity: 1; }
    100% { background-position: 200% 0; opacity: 0.35; }
  }
  .canvas__world :global(.row) {
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.22), transparent);
    mix-blend-mode: screen;
    opacity: 0;
    animation: pg-row 3.3s ease-in-out var(--d) infinite;
  }
  @keyframes pg-row {
    0%, 100% { opacity: 0; }
    30%, 45% { opacity: 1; }
  }
  .canvas__world :global(.ring) {
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    animation: pg-ring 4.8s ease-out var(--d) infinite backwards;
  }
  @keyframes pg-ring {
    0% { transform: scale(0.15); opacity: 0; }
    20% { opacity: 0.9; }
    100% { transform: scale(1); opacity: 0; }
  }
  .canvas__world :global(.sheen) {
    inset: 0;
    background: linear-gradient(115deg, transparent 40%, rgb(255 255 255 / 0.16) 50%, transparent 60%) no-repeat;
    background-size: 250% 100%;
    animation: pg-sheen 8s ease-in-out calc(var(--i) * -1.1s) infinite;
  }
  @keyframes pg-sheen {
    0%, 60% { background-position: 150% 0; }
    85%, 100% { background-position: -50% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .canvas__world :global(.piece--anim *) {
      animation: none !important;
    }
    .canvas__world :global(.fx) {
      display: none;
    }
  }

  /* ---------- Blurred edges (progressive: 3 layers each) ---------- */
  .edge {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }
  .edge i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: linear-gradient(var(--dir), #000 var(--from), transparent 100%);
    mask-image: linear-gradient(var(--dir), #000 var(--from), transparent 100%);
  }
  .edge i:nth-child(1) { --b: 2px; --from: 40%; }
  .edge i:nth-child(2) { --b: 6px; --from: 20%; }
  .edge i:nth-child(3) { --b: 14px; --from: 0%; }
  .edge--l,
  .edge--r {
    top: 0;
    bottom: 0;
    width: min(14vw, 220px);
  }
  .edge--l {
    left: 0;
    --dir: to right;
  }
  .edge--r {
    right: 0;
    --dir: to left;
  }
  .edge--b {
    left: 0;
    right: 0;
    bottom: 0;
    height: min(16vh, 160px);
    --dir: to top;
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 3;
    transform: translateX(-50%);
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font-size: 13px;
    letter-spacing: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .canvas.was-dragged .hint {
    opacity: 0;
  }
</style>

<script>
  // Endless, draggable canvas with momentum and speed-based motion blur.
  type Canvas = {
    el: HTMLElement;
    world: HTMLElement;
    /** canvas offset in Figma px */
    x: number;
    y: number;
    /** extra vertical offset driven by page scroll (set from the home page script) */
    scrollY: number;
    /** 0 → 1 while the playground slides into view (pieces rise into place) */
    enter: number;
    vx: number;
    vy: number;
    scale: number;
    cols: { run: HTMLElement; period: number; k: number }[];
    tileW: number;
  };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function build(el: HTMLElement): Canvas {
    const world = el.querySelector<HTMLElement>('[data-world]')!;
    const tpl = el.querySelector<HTMLTemplateElement>('[data-tile]')!;
    const tileW = Number(el.dataset.tileW);
    const c: Canvas = { el, world, x: -207.5, y: -280, scrollY: 0, enter: 1, vx: 0, vy: 0, scale: 1, cols: [], tileW };

    const layout = () => {
      const w = el.clientWidth;
      const h = el.clientHeight;
      // Desktop follows the 3008px Figma frame but never gets tiny; phones get a fixed scale
      c.scale = w >= 1024 ? Math.max(w / 3008, 0.55) : 0.5;
      world.replaceChildren();
      c.cols = [];
      const tilesX = Math.ceil(w / c.scale / tileW) + 1;
      for (let t = 0; t < tilesX; t++) {
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        frag.querySelectorAll<HTMLElement>('[data-col]').forEach((col) => {
          col.style.left = `${parseFloat(col.style.left) + t * tileW}px`;
          const run = col.querySelector<HTMLElement>('[data-run]')!;
          const period = Number(col.dataset.period);
          // Repeat the column's pieces so it always covers the screen height
          const reps = Math.ceil(h / c.scale / period) + 1;
          const first = [...run.children];
          for (let r = 1; r < reps; r++) {
            first.forEach((p) => {
              const copy = p.cloneNode(true) as HTMLElement;
              copy.style.top = `${parseFloat((p as HTMLElement).style.top) + r * period}px`;
              run.append(copy);
            });
          }
          c.cols.push({ run, period, k: c.cols.length % 3 });
        });
        world.append(frag);
      }
      render(c);
      watch(world);
    };
    layout();
    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(layout, 150);
    });
    return c;
  }

  // Animated pieces only play while they're on screen
  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('on', e.isIntersecting)))
    : null;
  function watch(world: HTMLElement) {
    io?.disconnect();
    world.querySelectorAll('.piece--anim').forEach((p) => (io ? io.observe(p) : p.classList.add('on')));
  }
  const wrap = (v: number, p: number) => ((v % p) + p) % p - p;

  function render(c: Canvas, blur = 0) {
    const y = c.y - c.scrollY;
    c.world.style.transform = `scale(${c.scale}) translate3d(${wrap(c.x, c.tileW)}px,0,0)`;
    // While entering, the columns are hidden; then each one fades in and rises into place,
    // staggered left → right
    const progress = (k: number) => (c.enter >= 1 ? 1 : Math.min(1, Math.max(0, c.enter * 1.6 - k * 0.25)));
    c.cols.forEach(({ run, period, k }) => {
      const t = progress(k);
      const lift = Math.pow(1 - t, 3) * (c.el.clientHeight / c.scale) * 0.4;
      run.style.transform = `translate3d(0,${wrap(y, period) + lift}px,0)`;
      run.style.opacity = t >= 1 ? '' : String(Math.min(1, t * 1.4).toFixed(3));
    });
    c.world.style.filter = blur > 0.3 ? `blur(${blur.toFixed(1)}px)` : '';
  }

  document.querySelectorAll<HTMLElement>('[data-canvas]').forEach((el) => {
    const c = build(el);
    (el as any).__canvas = c;

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let lastT = 0;
    let raf = 0;

    const tick = () => {
      if (!dragging) {
        // Momentum: keep gliding and slow down
        c.x += c.vx;
        c.y += c.vy;
        c.vx *= 0.94;
        c.vy *= 0.94;
      }
      const speed = Math.hypot(c.vx, c.vy) * c.scale;
      render(c, reduce ? 0 : Math.min(10, speed * 0.6));
      if (dragging || Math.abs(c.vx) > 0.05 || Math.abs(c.vy) > 0.05) raf = requestAnimationFrame(tick);
      else {
        raf = 0;
        render(c);
      }
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = performance.now();
      c.vx = c.vy = 0;
      el.classList.add('is-dragging', 'was-dragged');
      // Touch: only horizontal swipes move the canvas, so vertical swipes still scroll the page
      if (e.pointerType === 'mouse') el.setPointerCapture(e.pointerId);
      kick();
    });
    el.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      const dx = (e.clientX - lastX) / c.scale;
      const dy = e.pointerType === 'mouse' ? (e.clientY - lastY) / c.scale : 0;
      c.x += dx;
      c.y += dy;
      // velocity in Figma px per frame (~16ms)
      c.vx = (dx / dt) * 16;
      c.vy = (dy / dt) * 16;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = now;
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      el.classList.remove('is-dragging');
      if (performance.now() - lastT > 80) c.vx = c.vy = 0;
      kick();
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    el.addEventListener('lostpointercapture', end);

    // Let the page script move the canvas with scroll
    // …and to bring the pieces in from the bottom as the playground arrives
    el.addEventListener('canvas:enter', ((e: CustomEvent<number>) => {
      c.enter = e.detail;
      el.style.setProperty('--fade', `${((1 - e.detail) * 30).toFixed(2)}vh`);
      if (!raf) render(c);
    }) as EventListener);
    el.addEventListener('canvas:scroll', ((e: CustomEvent<number>) => {
      c.scrollY = e.detail;
      if (!raf) render(c);
    }) as EventListener);
  });
</script>
