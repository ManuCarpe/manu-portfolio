---
// The Playground: one board holding every piece once (no repeats). Drag (or swipe) to move
// around; it keeps gliding after you let go, with a motion blur that follows the speed, and
// eases back when you pull past an edge. The edges of the screen are softly blurred.
// Click a piece to view it large: it moves to the middle (about 80% of the screen) and the
// others move out of its way; click another piece to swap, or × / Esc / the background to
// put everything back. Pieces and their animations come from src/data/playground.ts.
//
// The server renders the pieces in order; the script arranges them into as many columns as
// suit the screen (shortest column first) and keeps the board inside the screen.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ANIM, frames, tile } from '../data/playground';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/playground-v4/*.png', { eager: true });
const img = (k: string) => files[`../assets/playground-v4/${k}.png`]?.default;

// Every frame once, in order (frames without an export yet are skipped)
type Piece = { k: string; h: number; W: number; H: number };
const pieces: Piece[] = [];
for (const k of Object.keys(frames).sort()) {
  const a = ANIM[k];
  if (!img(k) && !(a?.scroll && img(`${k}-long`))) continue;
  const [W, H] = frames[k];
  pieces.push({ k, h: Math.round((tile.card * H) / W), W, H });
}
// A starting arrangement (used without JavaScript); the script re-arranges for the screen
const START_COLS = 12;
const ends = Array(START_COLS).fill(0);
const at = pieces.map((p) => {
  const i = ends.indexOf(Math.min(...ends));
  const pos = { x: i * tile.colGap, y: ends[i] };
  ends[i] += p.h + tile.gap;
  return pos;
});
// Position helpers: Figma px inside a frame → % of the card
const box = (r: number[], W: number, H: number) =>
  `left:${(r[0] / W) * 100}%;top:${(r[1] / H) * 100}%;width:${(r[2] / W) * 100}%;height:${(r[3] / H) * 100}%`;
const px = (r: number[], W: number) => Math.min(1600, Math.round((r[2] / W) * 654));
let n = 0;
---
<div class="canvas" data-canvas data-card={tile.card} data-gap={tile.gap} data-col-gap={tile.colGap} aria-label="Playground — drag to explore" role="region">
  <div class="canvas__world" data-world>
            {pieces.map(({ k, h, W, H }, idx) => {
              const y = at[idx].y;
              const a = ANIM[k] ?? {};
              const base = img(k);
              const long = a.scroll && img(`${k}-long`);
              const s = a.scroll;
              return (
                <div class:list={['piece', a && Object.keys(a).length && 'piece--anim']} data-piece data-h={h} style={`left:${at[idx].x}px;top:${y}px;height:${h}px;--i:${n++ % 7}`}>
                  {long && s ? (
                    <Image class="lyr scroll" src={long} alt="" width={px(s, W)} loading="lazy" decoding="async" draggable="false"
                      style={`${box(s, W, H)};top:0;--sy:${-(1 - H / s[3]) * 100}%`} />
                  ) : base && (
                    <Image class="piece__img" src={base} alt="" widths={[240, 480, 654, 1200, 1800].filter((w) => w <= base.width)}
                      sizes="(max-width: 1023px) 110px, (max-width: 2200px) 132px, 220px" loading="lazy" decoding="async" draggable="false" />
                  )}
                  {a.layers?.map(([key, ...r]) => {
                    const src = img(`${k}-${key}`);
                    const [x, yy, w, hh, fx, d] = r as [number, number, number, number, string, number];
                    return src && (fx === 'marquee' ? (
                      <div class="lyr marquee" style={box([x, yy, w, hh], W, H)}>
                        <div class="marquee__track">
                          <Image src={src} alt="" width={px([0, 0, w], W)} loading="lazy" draggable="false" />
                          <Image src={src} alt="" width={px([0, 0, w], W)} loading="lazy" draggable="false" />
                        </div>
                      </div>
                    ) : (
                      <Image class={`lyr fx-${fx}`} src={src} alt="" width={px([0, 0, w], W)} loading="lazy" decoding="async" draggable="false"
                        style={`${box([x, yy, w, hh], W, H)};--d:${d}s`} />
                    ));
                  })}
                  {a.pulses?.map((r, i) => <i class="fx pulse" style={`${box(r, W, H)};--d:${i * 0.6}s`} />)}
                  {a.dots?.map((r, i) => <i class="fx dot" style={`${box(r, W, H)};--d:${i * 0.45}s`} />)}
                  {a.glow?.map((r) => <i class="fx glow" style={box(r, W, H)} />)}
                  {a.rows?.map((r, i) => <i class="fx row" style={`${box(r, W, H)};--d:${i * 1.1}s`} />)}
                  {a.rings && [0, 1, 2].map((i) => {
                    const [cx, cy, R] = a.rings!;
                    return <i class="fx ring" style={`${box([cx - R, cy - R, R * 2, R * 2], W, H)};--d:${i * 1.6}s`} />;
                  })}
                  {a.sheen && <i class="fx sheen" />}
                </div>
              );
            })}
  </div>

  <!-- Soft, progressively blurred edges -->
  <div class="edge edge--l" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="edge edge--r" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="edge edge--b" aria-hidden="true"><i></i><i></i><i></i></div>

  <button class="close" type="button" data-close aria-label="Close the large view" tabindex="-1">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>

  <p class="hint" aria-hidden="true">Drag to explore · click to view</p>
</div>

<style>
  .canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Soft top edge while the playground slides in (set by the home page script) */
  .canvas {
    --fade: 0vh;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade));
    mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade));
  }
  .canvas.is-dragging {
    cursor: grabbing;
  }
  .canvas__world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform, filter;
  }
  .canvas__world :global(.col) {
    position: absolute;
    top: 0;
    width: 218px;
  }
  .canvas__world :global(.piece) {
    position: absolute;
    transform-origin: 0 0;
    /* opening / closing the large view (the board itself moves by its own transform) */
    transition:
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease;
    cursor: zoom-in;
    left: 0;
    width: 218px;
    overflow: hidden;
    contain: layout paint;
  }
  .canvas__world :global(.piece img) {
    -webkit-user-drag: none;
  }
  .canvas__world :global(.piece__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .canvas__world :global(.lyr),
  .canvas__world :global(.fx) {
    position: absolute;
    display: block;
  }

  /* ---------- Piece animations (play only while the piece is on screen: .on) ---------- */
  .canvas__world :global(.piece--anim *) {
    animation-play-state: paused !important;
  }
  .canvas__world :global(.piece--anim.on *) {
    animation-play-state: running !important;
  }
  /* Long page scrolling inside its frame, then back up */
  .canvas__world :global(.scroll) {
    max-width: none;
    animation: pg-scroll 22s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes pg-scroll {
    0%, 8% { transform: translateY(0); }
    46%, 54% { transform: translateY(var(--sy)); }
    92%, 100% { transform: translateY(0); }
  }
  /* Layers: 7s loop — come in, hold, leave */
  .canvas__world :global(.fx-reveal) {
    animation: pg-reveal 7s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes pg-reveal {
    0% { clip-path: circle(0% at 50% 56%); opacity: 0; }
    10% { opacity: 1; }
    45%, 85% { clip-path: circle(80% at 50% 56%); opacity: 1; }
    95%, 100% { clip-path: circle(80% at 50% 56%); opacity: 0; }
  }
  .canvas__world :global(.fx-rise) {
    animation: pg-rise 7s cubic-bezier(0.22, 1, 0.36, 1) var(--d) infinite backwards;
  }
  @keyframes pg-rise {
    0% { transform: translateY(18%); opacity: 0; }
    12%, 80% { transform: none; opacity: 1; }
    92%, 100% { transform: translateY(-10%); opacity: 0; }
  }
  .canvas__world :global(.fx-pop) {
    transform-origin: 50% 100%;
    animation: pg-pop 7s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d) infinite backwards;
  }
  @keyframes pg-pop {
    0% { transform: scale(0.6) translateY(12%); opacity: 0; }
    10%, 80% { transform: none; opacity: 1; }
    90%, 100% { transform: scale(0.9); opacity: 0; }
  }
  /* Card stack: cards roll in from the back, one after another, then roll away */
  .canvas__world :global(.fx-roll) {
    transform-origin: 50% 0;
    animation: pg-roll 6s cubic-bezier(0.22, 1, 0.36, 1) var(--d) infinite backwards;
  }
  @keyframes pg-roll {
    0% { transform: perspective(600px) translateY(40%) rotateX(-70deg); opacity: 0; }
    14%, 74% { transform: none; opacity: 1; }
    88%, 100% { transform: perspective(600px) translateY(-30%) rotateX(50deg); opacity: 0; }
  }
  /* Two states of a component, cross-fading (Figma smart animate, 1.25s) */
  .canvas__world :global(.fx-swapA) { animation: pg-swap 5s ease-in-out infinite; }
  .canvas__world :global(.fx-swapB) { animation: pg-swap 5s ease-in-out -2.5s infinite; }
  @keyframes pg-swap {
    0%, 37% { opacity: 1; transform: none; }
    50%, 87% { opacity: 0; transform: scale(0.97); }
    100% { opacity: 1; transform: none; }
  }
  /* Very slow marquee */
  .canvas__world :global(.marquee) {
    overflow: hidden;
  }
  .canvas__world :global(.marquee__track) {
    display: flex;
    width: 200%;
    height: 100%;
    animation: pg-marquee 60s linear infinite;
  }
  .canvas__world :global(.marquee__track img) {
    width: 50%;
    height: 100%;
    max-width: none;
  }
  @keyframes pg-marquee {
    to { transform: translateX(-50%); }
  }
  /* CSS-only accents */
  .canvas__world :global(.pulse) {
    border: 1.5px solid rgb(140 255 220 / 0.8);
    border-radius: 50%;
    animation: pg-pulse 2.4s ease-out var(--d) infinite backwards;
  }
  @keyframes pg-pulse {
    0% { transform: scale(0.3); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  .canvas__world :global(.dot) {
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgb(120 255 210 / 0.6);
    animation: pg-dot 2.7s ease-out var(--d) infinite;
  }
  @keyframes pg-dot {
    0% { box-shadow: 0 0 0 0 rgb(120 255 210 / 0.55); }
    80%, 100% { box-shadow: 0 0 0 10px rgb(120 255 210 / 0); }
  }
  .canvas__world :global(.glow) {
    border-radius: 8px;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%) -200% 0 / 200% 100% no-repeat;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25), 0 0 24px rgb(160 140 255 / 0.35);
    mix-blend-mode: screen;
    animation: pg-glow 3.6s ease-in-out infinite;
  }
  @keyframes pg-glow {
    0% { background-position: -200% 0; opacity: 0.35; }
    50% { opacity: 1; }
    100% { background-position: 200% 0; opacity: 0.35; }
  }
  .canvas__world :global(.row) {
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.22), transparent);
    mix-blend-mode: screen;
    opacity: 0;
    animation: pg-row 3.3s ease-in-out var(--d) infinite;
  }
  @keyframes pg-row {
    0%, 100% { opacity: 0; }
    30%, 45% { opacity: 1; }
  }
  .canvas__world :global(.ring) {
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    animation: pg-ring 4.8s ease-out var(--d) infinite backwards;
  }
  @keyframes pg-ring {
    0% { transform: scale(0.15); opacity: 0; }
    20% { opacity: 0.9; }
    100% { transform: scale(1); opacity: 0; }
  }
  .canvas__world :global(.sheen) {
    inset: 0;
    background: linear-gradient(115deg, transparent 40%, rgb(255 255 255 / 0.16) 50%, transparent 60%) no-repeat;
    background-size: 250% 100%;
    animation: pg-sheen 8s ease-in-out calc(var(--i) * -1.1s) infinite;
  }
  @keyframes pg-sheen {
    0%, 60% { background-position: 150% 0; }
    85%, 100% { background-position: -50% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .canvas__world :global(.piece--anim *) {
      animation: none !important;
    }
    .canvas__world :global(.fx) {
      display: none;
    }
  }

  /* ---------- Large view ---------- */
  .canvas.is-dragging :global(.piece) {
    cursor: grabbing;
  }
  .canvas.is-focus {
    cursor: zoom-out;
    touch-action: none;
  }
  .canvas.is-focus .canvas__world :global(.piece) {
    opacity: 0.45;
  }
  .canvas.is-focus .canvas__world :global(.piece:hover) {
    opacity: 0.85;
  }
  .canvas__world :global(.col.has-focus) {
    z-index: 5;
  }
  .canvas.is-focus .canvas__world :global(.piece.is-focused) {
    opacity: 1;
    cursor: default;
  }
  .close {
    position: absolute;
    left: 50%;
    top: calc(var(--header-h, 100px) + 4px);
    z-index: 6;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.12);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-8px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .close svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .canvas.is-focus .close {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .close:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }
  .canvas.is-focus .edge,
  .canvas.is-focus .hint {
    opacity: 0;
  }

  /* ---------- Blurred edges (progressive: 3 layers each) ---------- */
  .edge {
    position: absolute;
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.5s ease;
  }
  .edge i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: linear-gradient(var(--dir), #000 var(--from), transparent 100%);
    mask-image: linear-gradient(var(--dir), #000 var(--from), transparent 100%);
  }
  .edge i:nth-child(1) { --b: 2px; --from: 40%; }
  .edge i:nth-child(2) { --b: 6px; --from: 20%; }
  .edge i:nth-child(3) { --b: 14px; --from: 0%; }
  .edge--l,
  .edge--r {
    top: 0;
    bottom: 0;
    width: min(14vw, 220px);
  }
  .edge--l {
    left: 0;
    --dir: to right;
  }
  .edge--r {
    right: 0;
    --dir: to left;
  }
  .edge--b {
    left: 0;
    right: 0;
    bottom: 0;
    height: min(16vh, 160px);
    --dir: to top;
  }

  .hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 3;
    transform: translateX(-50%);
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font-size: 13px;
    letter-spacing: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .canvas.was-dragged .hint {
    opacity: 0;
  }
</style>

<script>
  // A finite, draggable board with momentum, speed-based motion blur and soft edges.
  type Col = { el: HTMLElement; x: number };
  type Canvas = {
    el: HTMLElement;
    world: HTMLElement;
    /** board offset in Figma px (x, and y before the page-scroll drift) */
    x: number;
    y: number;
    /** vertical drift driven by page scroll (set from the home page script) */
    scrollY: number;
    /** 0 → 1 while the playground slides into view (pieces rise into place) */
    enter: number;
    vx: number;
    vy: number;
    scale: number;
    cols: Col[];
    /** board size in Figma px */
    w: number;
    h: number;
    placed: boolean;
  };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  function build(el: HTMLElement): Canvas {
    const world = el.querySelector<HTMLElement>('[data-world]')!;
    const pieces = [...world.querySelectorAll<HTMLElement>('[data-piece]')];
    const card = Number(el.dataset.card);
    const gap = Number(el.dataset.gap);
    const colGap = Number(el.dataset.colGap);
    const stack = pieces.reduce((s, p) => s + Number(p.dataset.h) + gap, 0);
    const c: Canvas = { el, world, x: 0, y: 0, scrollY: 0, enter: 1, vx: 0, vy: 0, scale: 1, cols: [], w: 0, h: 0, placed: false };

    const layout = () => {
      el.dispatchEvent(new Event('canvas:relayout'));
      const w = el.clientWidth;
      const h = el.clientHeight;
      const touch = w < 1024;
      // Desktop follows the 3008px Figma frame but never gets tiny; phones get a fixed scale
      c.scale = touch ? 0.5 : Math.max(w / 3008, 0.55);
      const viewW = w / c.scale;
      const viewH = h / c.scale;
      // Columns: on desktop the board takes the screen's shape (about 2 screens each way);
      // on phones you only swipe sideways, so the board is wide and about as tall as the
      // screen plus what the page scroll drifts it by.
      const n = touch
        ? Math.ceil(stack / (viewH + h * 1.1))
        : Math.round(Math.sqrt(((viewW / viewH) * stack) / colGap));
      const count = clamp(n, 3, pieces.length);

      // Keep the same spot in view across re-layouts
      const fx = c.placed ? (viewW / 2 - c.x) / Math.max(1, c.w) : 0.5;
      const fy = c.placed ? (viewH / 2 - (c.y - c.scrollY)) / Math.max(1, c.h) : 0;

      world.replaceChildren();
      c.cols = Array.from({ length: count }, (_, i) => {
        const col = document.createElement('div');
        col.className = 'col';
        col.dataset.x = String(i * colGap);
        col.style.left = `${i * colGap}px`;
        world.append(col);
        return { el: col, x: i * colGap };
      });
      const ends = Array(count).fill(0);
      pieces.forEach((p) => {
        const i = ends.indexOf(Math.min(...ends));
        p.style.left = '0';
        p.style.top = `${ends[i]}px`;
        c.cols[i].el.append(p);
        ends[i] += Number(p.dataset.h) + gap;
      });
      c.w = (count - 1) * colGap + card;
      c.h = Math.max(...ends) - gap;

      const b = bounds(c);
      if (!c.placed) {
        // start centred sideways, at the top (the page scroll drifts it down from there)
        c.x = clamp((viewW - c.w) / 2, b.minX, b.maxX);
        c.y = b.maxY + c.scrollY;
        c.placed = true;
      } else {
        c.x = clamp(viewW / 2 - fx * c.w, b.minX, b.maxX);
        c.y = clamp(viewH / 2 - fy * c.h, b.minY, b.maxY) + c.scrollY;
      }
      render(c);
      watch(world);
    };
    layout();
    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(layout, 150);
    });
    return c;
  }

  /** How far the board may move (Figma px): it can't leave the screen, with a margin so the
      outer pieces clear the blurred edges and the header. */
  function bounds(c: Canvas) {
    const w = c.el.clientWidth;
    const h = c.el.clientHeight;
    const viewW = w / c.scale;
    const viewH = h / c.scale;
    const side = Math.min(w * 0.08, 140) / c.scale;
    const top = Math.max(110, h * 0.14) / c.scale;
    const bottom = Math.min(h * 0.12, 140) / c.scale;
    let minX = viewW - side - c.w;
    let maxX = side;
    if (minX > maxX) minX = maxX = (viewW - c.w) / 2;
    let minY = viewH - bottom - c.h;
    const maxY = top;
    if (minY > maxY) minY = maxY;
    return { minX, maxX, minY, maxY };
  }

  // Animated pieces only play while they're on screen
  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('on', e.isIntersecting)))
    : null;
  function watch(world: HTMLElement) {
    io?.disconnect();
    world.querySelectorAll('.piece--anim').forEach((p) => (io ? io.observe(p) : p.classList.add('on')));
  }

  function render(c: Canvas, blur = 0) {
    const y = c.y - c.scrollY;
    c.world.style.transform = `scale(${c.scale}) translate3d(${c.x}px,${y}px,0)`;
    // While entering, the columns are hidden; then each one fades in and rises into place,
    // staggered left → right across the screen
    const w = c.el.clientWidth || 1;
    c.cols.forEach(({ el, x }) => {
      let t = 1;
      if (c.enter < 1) {
        const sx = clamp(((x + c.x) * c.scale) / w, 0, 1);
        t = clamp(c.enter * 1.6 - sx * 0.6, 0, 1);
      }
      const lift = Math.pow(1 - t, 3) * (c.el.clientHeight / c.scale) * 0.4;
      el.style.transform = lift ? `translate3d(0,${lift}px,0)` : '';
      el.style.opacity = t >= 1 ? '' : Math.min(1, t * 1.4).toFixed(3);
    });
    c.world.style.filter = blur > 0.3 ? `blur(${blur.toFixed(1)}px)` : '';
  }

  document.querySelectorAll<HTMLElement>('[data-canvas]').forEach((el) => {
    const c = build(el);
    (el as any).__canvas = c;

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let lastT = 0;
    let raf = 0;

    const tick = () => {
      let settling = false;
      if (!dragging) {
        // Momentum: keep gliding and slow down…
        c.x += c.vx;
        c.y += c.vy;
        c.vx *= 0.94;
        c.vy *= 0.94;
        // …and ease back inside if it went past an edge
        const b = bounds(c);
        const y = c.y - c.scrollY;
        const tx = clamp(c.x, b.minX, b.maxX);
        const ty = clamp(y, b.minY, b.maxY);
        if (tx !== c.x) {
          c.vx *= 0.5;
          c.x += (tx - c.x) * 0.16;
          settling ||= Math.abs(tx - c.x) > 0.3;
          if (!settling) c.x = tx;
        }
        if (ty !== y) {
          c.vy *= 0.5;
          c.y += (ty - y) * 0.16;
          const left = Math.abs(ty - (c.y - c.scrollY));
          if (left > 0.3) settling = true;
          else c.y = ty + c.scrollY;
        }
      }
      const speed = Math.hypot(c.vx, c.vy) * c.scale;
      render(c, reduce ? 0 : Math.min(10, speed * 0.6));
      if (dragging || settling || Math.abs(c.vx) > 0.05 || Math.abs(c.vy) > 0.05) raf = requestAnimationFrame(tick);
      else {
        raf = 0;
        render(c);
      }
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    // ---------- Large view ----------
    const cardW = Number(el.dataset.card);
    let focused: HTMLElement | null = null;
    let focusScroll = 0;
    const others = () => [...el.querySelectorAll<HTMLElement>('[data-piece]')];
    /** A piece's place on screen (px, relative to the canvas) without any large-view offset */
    const home = (p: HTMLElement) => {
      const colX = Number(p.parentElement!.dataset.x);
      return {
        x: (colX + c.x) * c.scale,
        y: (parseFloat(p.style.top) + c.y - c.scrollY) * c.scale,
        w: cardW * c.scale,
        h: Number(p.dataset.h) * c.scale,
      };
    };

    const open = (p: HTMLElement) => {
      const W = el.clientWidth;
      const H = el.clientHeight;
      const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 100;
      const top = headerH + 60; // room for the × button
      const bottom = Math.max(24, H * 0.05);
      // Fit inside ~80% of the screen (long pieces fit by height)
      const r = home(p);
      const maxW = W * (W < 1024 ? 0.9 : 0.8);
      const maxH = Math.min(H * 0.8, H - top - bottom);
      let tw = maxW;
      let th = (tw * r.h) / r.w;
      if (th > maxH) {
        th = maxH;
        tw = (th * r.w) / r.h;
      }
      const tx = (W - tw) / 2;
      const ty = top + (H - top - bottom - th) / 2;

      if (focused && focused !== p) {
        focused.classList.remove('is-focused');
        focused.parentElement!.classList.remove('has-focus');
      }
      focused = p;
      focusScroll = c.scrollY;
      p.classList.add('is-focused');
      p.parentElement!.classList.add('has-focus');
      p.style.transform = `translate3d(${(tx - r.x) / c.scale}px,${(ty - r.y) / c.scale}px,0) scale(${tw / r.w})`;
      // a sharper image for the large size
      p.querySelectorAll<HTMLImageElement>('.piece__img').forEach((img) => (img.sizes = `${Math.round(tw)}px`));

      // Everything else moves straight out from the middle until it clears the large piece;
      // pieces close by are nudged too, so the neighbourhood opens up rather than piling up.
      const m = Math.min(W, H) * 0.035;
      const T = { l: tx - m, t: ty - m, r: tx + tw + m, b: ty + th + m };
      const cx = tx + tw / 2;
      const cy = ty + th / 2;
      const reach = Math.min(W, H);
      others().forEach((q) => {
        if (q === p) return;
        const R = home(q);
        let dx = R.x + R.w / 2 - cx;
        let dy = R.y + R.h / 2 - cy;
        const len = Math.hypot(dx, dy) || 1;
        dx /= len;
        dy /= len;
        const overlaps = R.x < T.r && R.x + R.w > T.l && R.y < T.b && R.y + R.h > T.t;
        let need = 0;
        if (overlaps) {
          const ts: number[] = [];
          if (dx > 0.001) ts.push((T.r - R.x) / dx);
          if (dx < -0.001) ts.push((T.l - (R.x + R.w)) / dx);
          if (dy > 0.001) ts.push((T.b - R.y) / dy);
          if (dy < -0.001) ts.push((T.t - (R.y + R.h)) / dy);
          need = Math.min(...ts.filter((t) => t > 0));
        }
        // distance from the piece to the large piece's area
        const gx = Math.max(T.l - (R.x + R.w), 0, R.x - T.r);
        const gy = Math.max(T.t - (R.y + R.h), 0, R.y - T.b);
        const nudge = reach * 0.28 * Math.exp(-Math.hypot(gx, gy) / (reach * 0.35));
        const push = Math.max(need, nudge);
        q.style.transform = push > 0.5 ? `translate3d(${(dx * push) / c.scale}px,${(dy * push) / c.scale}px,0)` : '';
      });

      if (!el.classList.contains('is-focus')) {
        el.classList.add('is-focus');
        el.dispatchEvent(new CustomEvent('canvas:focus', { detail: true, bubbles: true }));
      }
    };

    const close = () => {
      if (!focused) return;
      focused.classList.remove('is-focused');
      const col = focused.parentElement!;
      // keep it above the others until it has flown back
      window.setTimeout(() => col.classList.remove('has-focus'), 750);
      focused = null;
      others().forEach((q) => (q.style.transform = ''));
      el.classList.remove('is-focus');
      el.dispatchEvent(new CustomEvent('canvas:focus', { detail: false, bubbles: true }));
    };

    el.querySelector('[data-close]')!.addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });
    el.querySelector('[data-close]')!.addEventListener('pointerdown', (e) => e.stopPropagation());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && focused) close();
    });
    el.addEventListener('canvas:relayout', () => close());

    // A click is a press that barely moved
    let downX = 0;
    let downY = 0;
    let downT = 0;
    let downPiece: HTMLElement | null = null;
    el.addEventListener('pointerdown', (e) => {
      // remember what was pressed (pointer capture makes the click land on the canvas itself)
      downPiece = (e.target as HTMLElement).closest<HTMLElement>('[data-piece]');
      downX = e.clientX;
      downY = e.clientY;
      downT = performance.now();
    }, true);
    el.addEventListener('click', (e) => {
      if (Math.hypot(e.clientX - downX, e.clientY - downY) > 6 || performance.now() - downT > 600) return;
      const p = downPiece;
      if (p && p !== focused) open(p);
      else if (!p && focused) close();
    });

    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || focused) return;
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = performance.now();
      c.vx = c.vy = 0;
      el.classList.add('is-dragging', 'was-dragged');
      // Touch: only horizontal swipes move the board, so vertical swipes still scroll the page
      if (e.pointerType === 'mouse') el.setPointerCapture(e.pointerId);
      kick();
    });
    el.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      let dx = (e.clientX - lastX) / c.scale;
      let dy = e.pointerType === 'mouse' ? (e.clientY - lastY) / c.scale : 0;
      // Past an edge the board follows the pointer reluctantly (rubber band)
      const b = bounds(c);
      const y = c.y - c.scrollY;
      if ((c.x > b.maxX && dx > 0) || (c.x < b.minX && dx < 0)) dx *= 0.35;
      if ((y > b.maxY && dy > 0) || (y < b.minY && dy < 0)) dy *= 0.35;
      c.x += dx;
      c.y += dy;
      // velocity in Figma px per frame (~16ms)
      c.vx = (dx / dt) * 16;
      c.vy = (dy / dt) * 16;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = now;
    });
    // a click shouldn't fling the board
    el.addEventListener('pointerup', (e) => {
      if (Math.hypot(e.clientX - downX, e.clientY - downY) <= 6) c.vx = c.vy = 0;
    }, true);
    const end = () => {
      if (!dragging) return;
      dragging = false;
      el.classList.remove('is-dragging');
      if (performance.now() - lastT > 80) c.vx = c.vy = 0;
      kick();
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    el.addEventListener('lostpointercapture', end);

    // The page script brings the pieces in from the bottom as the playground arrives…
    el.addEventListener('canvas:enter', ((e: CustomEvent<number>) => {
      c.enter = e.detail;
      el.style.setProperty('--fade', `${((1 - e.detail) * 30).toFixed(2)}vh`);
      if (!raf) render(c);
    }) as EventListener);
    // …and drifts the board with the page scroll (it stops at the board's bottom edge)
    el.addEventListener('canvas:scroll', ((e: CustomEvent<number>) => {
      c.scrollY = e.detail;
      // the page moved on (e.g. a menu jump): put the large view away
      if (focused && Math.abs(c.scrollY - focusScroll) > 4) close();
      if (!dragging) {
        const b = bounds(c);
        c.y = clamp(c.y - c.scrollY, b.minY, b.maxY) + c.scrollY;
      }
      if (!raf) render(c);
    }) as EventListener);
  });
</script>
