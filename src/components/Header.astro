---
// Site header: "MANU. STUDIO" wordmark + stacked menu (Home / Case study / Playground / Connect)
// with the letter-roll hover.
//   active   which menu item is current; the others are dimmed to 20% like the Figma frames
//   solid    progressive blur behind the header so content scrolling underneath stays readable
//   overlay  fixed on top of the page (home page). The home page script switches the active
//            item and the blur as you scroll through its stages.
import Logo from './Logo.astro';
import { site, type NavKey } from '../data/site';

interface Props {
  active?: NavKey;
  solid?: boolean;
  overlay?: boolean;
}

const { active, solid = false, overlay = false } = Astro.props;
---

<header class:list={['header', { solid, overlay }]} data-header>
  <div class="pblur" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
  <a href="/" class="logo" aria-label="Manu Studio, home" data-nav-link="home">
    <Logo class="logo__svg" />
  </a>
  <nav class="nav display" aria-label="Primary">
    {site.nav.map((item) => (
      <a
        class:list={['roll', { dim: active && active !== item.key }]}
        href={item.href}
        aria-label={item.label}
        aria-current={active === item.key ? 'page' : undefined}
        data-nav-link={item.key}
      >
        {[...item.label].map((ch, i) => (
          <span class="char" aria-hidden="true" style={`--i:${i}`}>{ch === ' ' ? '\u00A0' : ch}</span>
        ))}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--pad-y) var(--pad-x);
    pointer-events: none;
  }
  .header > * {
    pointer-events: auto;
  }
  .overlay {
    position: fixed;
    inset: 0 0 auto;
  }

  .logo {
    display: block;
    color: var(--text);
  }
  .logo :global(.logo__svg) {
    display: block;
    width: max(64px, calc(189 * var(--u)));
    height: auto;
  }

  /* Menu: Barlow Condensed SemiBold 49, 80% line height, -5% tracking */
  .nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: max(3px, calc(7 * var(--u)));
    font-size: max(16px, calc(49 * var(--u)));
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  /* ---------- Progressive blur ----------
     Stacked layers, each blurring a bit more than the last and masked to a shorter band at
     the top, so the blur ramps from strong (top) to none (bottom). Shown with `solid`, or
     when the home page script adds .is-blurred. */
  .pblur {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + 28px);
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 83%, transparent) 0%,
      color-mix(in srgb, var(--bg) 50%, transparent) 55%,
      transparent 100%
    );
  }
  .solid .pblur,
  :global(.is-blurred) .pblur {
    opacity: 1;
  }
  .pblur i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: linear-gradient(to bottom, #000 var(--from), transparent var(--to));
    mask-image: linear-gradient(to bottom, #000 var(--from), transparent var(--to));
  }
  .pblur i:nth-child(1) { --b: 0.5px; --from: 55%; --to: 100%; }
  .pblur i:nth-child(2) { --b: 1px;   --from: 45%; --to: 88%; }
  .pblur i:nth-child(3) { --b: 2px;   --from: 35%; --to: 76%; }
  .pblur i:nth-child(4) { --b: 4px;   --from: 25%; --to: 64%; }
  .pblur i:nth-child(5) { --b: 8px;   --from: 12%; --to: 52%; }
  .pblur i:nth-child(6) { --b: 16px;  --from: 0%;  --to: 40%; }

  .dim {
    opacity: 0.2;
    transition: opacity 0.25s ease;
  }
  .dim:hover,
  .dim:focus-visible {
    opacity: 1;
  }

  /* Letter-by-letter roll: each letter slides up and an identical copy (drawn with
     text-shadow 1.6em below, out of view) rolls in, one letter after another.
     The box is padded so the tall caps aren't clipped by the tight 0.8 line height. */
  .roll {
    display: inline-flex;
    overflow: hidden;
    padding: 0.12em 0 0.06em;
    margin: -0.12em 0 -0.06em;
  }
  .char {
    display: inline-block;
    text-shadow: 0 1.6em currentColor;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--i) * 25ms);
  }
  .roll:hover .char,
  .roll:focus-visible .char {
    transform: translateY(-1.6em);
  }
  @media (prefers-reduced-motion: reduce) {
    .char {
      transition: none;
    }
    .roll:hover .char,
    .roll:focus-visible .char {
      transform: none;
    }
    .roll:hover {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
  }
</style>
