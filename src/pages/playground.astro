---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { grid, freeflow, canvas, cardWidth } from '../data/playground';
import { site } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/playground/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const img = (key: string) => {
  const hit = Object.entries(files).find(([path]) => path.includes(`/${key}.`));
  if (!hit) throw new Error(`Playground image "${key}" not found in src/assets/playground`);
  return hit[1].default;
};
---

<Base title={`Playground — ${site.name}`}>
  <Header active="playground" solid />

  <main class="playground" data-view="grid">
    <h1 class="sr-only">Playground</h1>

    <div class="toggle" role="group" aria-label="Layout">
      <button type="button" class="toggle__btn" data-set-view="grid" aria-pressed="true" aria-label="Grid view">
        <svg viewBox="0 0 35 35" aria-hidden="true">
          <path d="M13 9H23V20H13V9Z" /><rect x="25" y="14" width="6" height="6" /><rect x="5" y="14" width="6" height="6" />
          <rect x="25" y="21" width="6" height="4" /><path d="M13 21H23V28H13V21Z" /><rect x="5" y="21" width="6" height="4" />
        </svg>
      </button>
      <button type="button" class="toggle__btn" data-set-view="freeflow" aria-pressed="false" aria-label="Freeflow view">
        <svg viewBox="0 0 35 35" aria-hidden="true">
          <circle cx="16.5" cy="21.5" r="6.5" /><circle cx="16.5" cy="7.5" r="2.5" /><circle cx="6.5" cy="27.5" r="1.5" />
          <circle cx="27.5" cy="14.5" r="3.5" /><circle cx="6.5" cy="14.5" r="2.5" />
        </svg>
      </button>
    </div>

    <!-- Grid view: six columns (columns 4–6 repeat 1–3 in Figma, so smaller screens show 1–3 only) -->
    <section class="grid" data-view-panel="grid" aria-label="Work, grid">
      {grid.map((col, c) => (
        <ul class:list={['col', { repeat: c >= 3 }]}>
          {col.map((key, i) => (
            <li>
              <Image
                src={img(key)}
                alt=""
                widths={[360, 714]}
                sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 16vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </li>
          ))}
        </ul>
      ))}
    </section>

    <!-- Freeflow view: scattered cards you can drag around -->
    <section class="free" data-view-panel="freeflow" aria-label="Work, freeflow" hidden>
      <div class="canvas" style={`--cw:${canvas.w};--ch:${canvas.h}`}>
        {freeflow.map(({ k, x, y }) => (
          <div class="card" style={`--x:${x};--y:${y};--w:${cardWidth}`}>
            <Image src={img(k)} alt="" widths={[240, 480]} sizes="(max-width: 1023px) 120px, 8vw" draggable="false" />
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  const main = document.querySelector<HTMLElement>('.playground');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-view]');
  const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');

  const setView = (view: string, push = true) => {
    if (!main) return;
    main.dataset.view = view;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setView === view)));
    panels.forEach((p) => (p.hidden = p.dataset.viewPanel !== view));
    if (push) history.replaceState(null, '', view === 'freeflow' ? '#freeflow' : location.pathname);
  };
  buttons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.setView!)));
  if (location.hash === '#freeflow') setView('freeflow', false);

  // Drag cards on the freeflow canvas
  let z = 10;
  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    let startX = 0, startY = 0, baseX = 0, baseY = 0;
    card.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return; // on phones the canvas scrolls instead
      card.setPointerCapture(e.pointerId);
      card.classList.add('dragging');
      card.style.zIndex = String(++z);
      startX = e.clientX;
      startY = e.clientY;
      baseX = parseFloat(card.dataset.dx || '0');
      baseY = parseFloat(card.dataset.dy || '0');
    });
    card.addEventListener('pointermove', (e) => {
      if (!card.hasPointerCapture(e.pointerId)) return;
      const dx = baseX + e.clientX - startX;
      const dy = baseY + e.clientY - startY;
      card.dataset.dx = String(dx);
      card.dataset.dy = String(dy);
      card.style.translate = `${dx}px ${dy}px`;
    });
    const end = (e: PointerEvent) => {
      if (card.hasPointerCapture(e.pointerId)) card.releasePointerCapture(e.pointerId);
      card.classList.remove('dragging');
    };
    card.addEventListener('pointerup', end);
    card.addEventListener('pointercancel', end);
  });
</script>

<style>
  .playground {
    padding: calc(91 * var(--u)) var(--pad-x) var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--u));
  }

  /* ---------- View toggle ---------- */
  .toggle {
    position: sticky;
    top: calc(max(22px, 63 * var(--u)) * 2.4 + var(--pad-y) * 2);
    z-index: 15;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .toggle__btn {
    width: clamp(28px, calc(35 * var(--u)), 35px);
    height: clamp(28px, calc(35 * var(--u)), 35px);
    opacity: 0.3;
    transition: opacity 0.2s ease;
  }
  .toggle__btn:hover,
  .toggle__btn[aria-pressed='true'] {
    opacity: 1;
  }
  .toggle__btn svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* ---------- Grid view ---------- */
  .grid {
    display: flex;
    gap: calc(24 * var(--u));
  }
  .col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(48.085 * var(--u));
  }
  .col img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .grid,
    .col {
      gap: 12px;
    }
    .repeat {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .grid {
      display: block;
      columns: 2;
      column-gap: 10px;
    }
    .col {
      display: contents;
    }
    .col.repeat {
      display: none;
    }
    .col li {
      break-inside: avoid;
      margin-bottom: 10px;
    }
  }

  /* ---------- Freeflow view ---------- */
  .free {
    --fu: var(--u);
    overflow-x: auto;
    overflow-y: hidden;
    margin: 0 calc(var(--pad-x) * -1);
    padding: 0 var(--pad-x);
    scrollbar-width: none;
  }
  .free::-webkit-scrollbar {
    display: none;
  }
  .canvas {
    position: relative;
    width: calc(var(--cw) * var(--fu));
    height: calc(var(--ch) * var(--fu));
  }
  .card {
    position: absolute;
    left: calc(var(--x) * var(--fu));
    top: calc(var(--y) * var(--fu));
    width: calc(var(--w) * var(--fu));
    cursor: grab;
    user-select: none;
    transition: scale 0.2s ease, filter 0.2s ease;
  }
  .card img {
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .card:hover {
    scale: 1.04;
  }
  .card.dragging {
    cursor: grabbing;
    scale: 1.08;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.25));
  }
  /* On small screens the canvas keeps a usable card size and scrolls sideways */
  @media (max-width: 1023px) {
    .free {
      --fu: 0.4px;
    }
  }
</style>
