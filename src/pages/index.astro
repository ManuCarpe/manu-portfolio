---
// The home page is one continuous scroll (Figma page "v2": Home 217:2434 → case studies
// 217:2640 → Playground 217:2549 → Connect 217:2884):
//   1. Home: portrait + "Product designer / Manu Mackal / 7+ years"
//   2. A #E0E0E0 layer pushes up from the bottom; the portrait shrinks behind it and the words
//      ride up on its top edge. The case study cards arrive stacked in the middle, then slide
//      out to their places and the row scrolls sideways.
//   3. Playground: an endless canvas you can drag around.
//   4. Connect: a sheet pushes up from the bottom.
// The animation lives in src/scripts/home.ts. Without JavaScript, or with reduced motion
// switched on, the same content simply stacks.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PlayCanvas from '../components/PlayCanvas.astro';
import photo from '../assets/home/manu.png';
import { site } from '../data/site';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const [firstWord, ...rest] = site.role.split(' ');
---

<Base>
  <Header active="home" overlay />

  <main class="home" data-home>
    <!-- ============ Home → Case studies ============ -->
    <section class="intro" id="home" data-intro aria-label="Introduction">
      <div class="hero" data-hero>
        <div class="hero__figure" data-photo>
          <Image
          class="hero__photo"
          src={photo}
          alt="Portrait of Manu Mackal"
          widths={[640, 960, 1280, 1536]}
          sizes="(max-width: 767px) 110vw, 56vh"
          loading="eager"
          fetchpriority="high"
          />
        </div>
        <div class="hero__dim" data-hero-dim aria-hidden="true"></div>
      </div>

      <div class="layer" data-layer>
        <!-- Sits on the layer's top edge, so the layer pushes it up -->
        <div class="hero__text display" data-hero-text>
          <h1 class="role">
            <span>{firstWord}</span>
            <span>{rest.join(' ')}</span>
          </h1>
          <p class="name">{site.name}</p>
          <p class="years">{site.experience}</p>
        </div>

        <div class="cases" id="case-study">
          <h2 class="sr-only">Case studies</h2>
          <ul class="strip" data-strip>
            {studies.map((s, i) => (
              <li class="card" data-card>
                <a class="card__link" href={`/case-study/${s.id}/`}>
                  <Image
                    class="card__img"
                    src={s.data.cover}
                    alt={s.data.coverAlt}
                    widths={[480, 720, 1044]}
                    sizes="(max-width: 767px) 80vw, 35vw"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                  <span class="card__fade" aria-hidden="true"><i></i><i></i><i></i></span>
                  <h3 class="card__title display">{s.data.title}</h3>
                  <span class="card__meta">
                    <span class="card__num">[ {String(i + 1).padStart(2, '0')} ]</span>
                    <span class="card__summary">{s.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ Playground → Connect ============ -->
    <section class="play" id="playground" data-play aria-label="Playground">
      <h2 class="sr-only">Playground</h2>
      <PlayCanvas />
      <div class="play__dim" data-dim aria-hidden="true"></div>

      <div class="sheet" id="connect" data-sheet>
        <h2 class="sheet__title display">Connect</h2>
        <div class="sheet__body">
          <a class="sheet__email display" href={`mailto:${site.email}`}>{site.email}</a>
          <ul class="sheet__links">
            {site.linkedin && <li><span>LinkedIn</span><a href={site.linkedin} target="_blank" rel="noopener">{site.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>}
            <li><span>Based in</span><span>{site.location}</span></li>
          </ul>
        </div>
        <p class="sheet__foot">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* ================= Home ================= */
  .intro {
    position: relative;
    overflow: hidden;
  }
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  /* The photo is a cut-out; it fills the height and sits in the middle (Figma: image FIT).
     The wrapper does the centring, so the scroll animation (scale + drift on the wrapper)
     never pushes it off-centre, whatever the window size. */
  .hero__figure {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
    transform-origin: 50% 35%;
  }
  .hero__photo {
    flex: none;
    height: 100%;
    width: auto;
    max-width: none;
  }

  /* Darkens the home screen as the layer pushes up over it (driven by the scroll) */
  .hero__dim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.22);
    opacity: 0;
    pointer-events: none;
  }

  /* The layer that pushes up over the home screen and carries the case studies */
  .layer {
    position: relative;
    background: var(--bg);
  }
  /* With motion the layer sits on top of the home screen and the script slides it up */
  :global(html.motion) .intro {
    height: 100vh;
    height: 100svh;
  }
  :global(html.motion) .layer {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  /* until the script takes over (avoids a flash of the layer) */
  :global(html.motion:not(.motion-ready)) .layer {
    transform: translateY(100%);
  }

  /* Product designer · Manu Mackal · 7+ years — white, bottom of the screen */
  .hero__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    padding: 0 var(--pad-x);
    color: #fff;
    pointer-events: none;
  }
  .role {
    display: flex;
    flex-direction: column;
    font-size: calc(265 * var(--u));
    line-height: calc(207 / 265);
    letter-spacing: -0.03em;
    font-weight: 600;
    /* Baselines as in Figma: "designer" sits 30px (at 3008) above the layer's edge.
       Barlow Condensed's baseline is 0.01em below the box at this line height. */
    margin-bottom: calc(32.65 * var(--u));
  }
  .name,
  .years {
    font-size: calc(108 * var(--u));
    line-height: 1;
    letter-spacing: -0.03em;
    /* baseline 14px (at 3008) above the edge; at line-height 1 it's 0.1em above the box */
    margin-bottom: calc(3.2 * var(--u));
  }
  .name {
    position: absolute;
    left: calc(1507.5 / 3008 * 100%);
    bottom: 0;
  }
  .years {
    justify-self: end;
    grid-column: 2;
  }

  /* ================= Case studies ================= */
  .cases {
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: calc(19 * var(--u));
    overflow: hidden;
  }
  .strip {
    display: flex;
    gap: calc(24 * var(--u));
    padding: 0 var(--pad-x);
    width: max-content;
  }
  .card {
    position: relative;
    flex: none;
    width: calc(1044 * var(--u));
    height: min(calc(1262 * var(--u)), calc(100svh - max(110px, 230 * var(--u))));
    will-change: transform;
  }
  .card__link {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    color: #fff;
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card__link:focus-visible {
    outline: 3px solid #000;
    outline-offset: 4px;
  }
  .card__link:hover .card__img {
    scale: 1.04;
  }
  .card__title {
    position: relative;
    padding: max(14px, calc(32 * var(--u)));
    font-size: max(24px, calc(82 * var(--u)));
    line-height: 0.94;
    letter-spacing: -0.03em;
  }
  /* Bottom quarter: dark tint + progressive blur behind the number and summary */
  .card__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 25%;
    background: linear-gradient(to bottom, rgba(31, 38, 51, 0), rgba(31, 38, 51, 0.18));
  }
  .card__fade i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: linear-gradient(to bottom, transparent var(--from), #000 100%);
    mask-image: linear-gradient(to bottom, transparent var(--from), #000 100%);
  }
  .card__fade i:nth-child(1) { --b: 4px; --from: 0%; }
  .card__fade i:nth-child(2) { --b: 12px; --from: 30%; }
  .card__fade i:nth-child(3) { --b: 30px; --from: 60%; }
  .card__meta {
    position: absolute;
    left: max(14px, calc(32 * var(--u)));
    right: 30%;
    bottom: max(14px, calc(32 * var(--u)));
    display: flex;
    flex-direction: column;
    gap: max(8px, calc(24 * var(--u)));
    font-size: max(13px, calc(28 * var(--u)));
    line-height: 1.19;
    letter-spacing: -0.03em;
  }

  /* ================= Playground + Connect ================= */
  .play {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .play__dim {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: rgba(0, 0, 0, 0.12);
    opacity: 0;
    pointer-events: none;
  }

  /* Connect sheet: #D9D9D9, 47.5% of the screen, pushed up from the bottom */
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    min-height: 47.5vh;
    min-height: 47.5svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 24px 32px;
    padding: max(20px, calc(42 * var(--u)));
    background: #d9d9d9;
  }
  .sheet__title {
    grid-column: 1 / -1;
    font-size: max(44px, calc(141 * var(--u)));
    line-height: 0.8;
    letter-spacing: -0.05em;
    opacity: 0.2;
  }
  .sheet__body {
    grid-column: 1 / -1;
    align-self: end;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 32px;
    align-items: end;
  }
  .sheet__email {
    font-size: max(30px, calc(120 * var(--u)));
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: none;
    word-break: break-all;
    transition: opacity 0.2s ease;
  }
  .sheet__email:hover {
    opacity: 0.6;
  }
  .sheet__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: max(15px, calc(28 * var(--u)));
  }
  .sheet__links li {
    display: grid;
    grid-template-columns: max(90px, calc(220 * var(--u))) 1fr;
    gap: 16px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  .sheet__links li > span:first-child {
    color: var(--muted);
  }
  .sheet__links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sheet__foot {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--muted);
  }

  /* Without motion the sheet just follows the playground */
  :global(html:not(.motion)) .play {
    height: auto;
  }
  :global(html:not(.motion)) .play :global(.canvas) {
    position: relative;
    height: 100vh;
    height: 100svh;
  }
  :global(html:not(.motion)) .sheet {
    position: relative;
  }

  /* ================= Phones ================= */
  @media (max-width: 767px) {
    .hero__text {
      grid-template-columns: 1fr auto;
      row-gap: 6px;
      padding-bottom: 14px;
    }
    .role {
      grid-column: 1 / -1;
      font-size: 64px;
      margin-bottom: 0;
    }
    .name,
    .years {
      position: static;
      font-size: 26px;
      margin: 0;
    }
    .years {
      grid-column: 2;
    }
    .cases {
      padding-bottom: 16px;
    }
    .strip {
      gap: 10px;
    }
    .card {
      width: 80vw;
      height: min(112vw, calc(100svh - 140px));
    }
    .card__meta {
      right: 14px;
    }
    .sheet,
    .sheet__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
