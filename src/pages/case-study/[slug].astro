---
// Case study page (Figma "case study content" 217:2672).
// Left: the project details panel — it stays in view (sticky) while the case study scrolls.
// Right: a white column — hero with the title on it, then the MDX sections.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import DripHeroArt from '../../components/case-study/DripHeroArt.astro';
import ArmadaHeroArt from '../../components/case-study/ArmadaHeroArt.astro';
import { site } from '../../data/site';
import { slugify, sectionTitles } from '../../lib/slug';

export async function getStaticPaths() {
  const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return studies.map((study) => ({ params: { slug: study.id }, props: { study, studies } }));
}

const { study, studies } = Astro.props;
const { title, summary, hero, heroAlt, heroArt, client, year, tags, about } = study.data;
const { Content } = await render(study);

// Project switcher: this case study first, then the others
const projects = [study, ...studies.filter((s) => s.id !== study.id)];
const sections = sectionTitles(study.body).map((t) => ({ title: t, id: slugify(t) }));
---

<Base title={`${title} — ${site.name}`} description={summary}>
  <Header active="case-study" solid />

  <div class="study">
    <!-- ===== Project details: sticks to the viewport ===== -->
    <aside class="side" aria-label="Project details" data-lenis-prevent>
      <nav class="projects" aria-label="Case studies">
        {projects.map((p) => (
          <a
            href={`/case-study/${p.id}/`}
            class:list={['thumb', { current: p.id === study.id }]}
            aria-current={p.id === study.id ? 'page' : undefined}
            title={p.data.title}
          >
            <Image src={p.data.cover} alt={p.data.title} widths={[70, 140]} sizes="70px" />
          </a>
        ))}
      </nav>

      <dl class="details">
        {year && (
          <div class="row">
            <dt>Year</dt>
            <dd>{year}</dd>
          </div>
        )}
        {client && (
          <div class="row">
            <dt>Client</dt>
            <dd>{client}</dd>
          </div>
        )}
        {tags.length > 0 && (
          <div class="row">
            <dt>Areas</dt>
            <dd class="tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </dd>
          </div>
        )}
        {about.length > 0 && (
          <div class="row">
            <dt>About</dt>
            <dd class="about">{about.map((p) => <p>{p}</p>)}</dd>
          </div>
        )}
      </dl>

      {sections.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc__label">Index</p>
          <ol class="toc__list display">
            {sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`} class:list={{ active: i === 0 }} data-toc={s.id}>{s.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>

    <!-- ===== Content ===== -->
    <main class="main">
      <div class="column">
        <header class:list={['hero', `hero--${heroArt}`]}>
          {hero && (
            <Image
              class="hero__bg"
              src={hero}
              alt={heroArt === 'none' ? heroAlt : ''}
              widths={[800, 1200, 1667, 2400].filter((w) => w <= hero.width * 1.5)}
              sizes="(max-width: 1023px) 100vw, 56vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <h1 class="hero__title display">{title}</h1>
          {heroArt === 'drip' && <DripHeroArt />}
          {heroArt === 'armada' && <ArmadaHeroArt />}
        </header>

        <Content />
      </div>
    </main>
  </div>
</Base>

<script>
  import '../../scripts/smooth';

  // Highlight the section you're reading in the Index
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const sections = [...document.querySelectorAll<HTMLElement>('[data-nav]')];
  if (links.size && sections.length) {
    const setActive = () => {
      const line = window.innerHeight * 0.35;
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      links.forEach((a, id) => a.classList.toggle('active', id === current.dataset.nav));
    };
    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
    window.addEventListener('resize', setActive);
  }
</script>

<style>
  .study {
    /* header height: logo (189 × 128) + padding */
    --side-top: calc(max(64px, 189 * var(--u)) * 128 / 189 + var(--pad-y) * 2);
    display: flex;
    align-items: flex-start;
    gap: 42px;
    padding: 0 var(--pad-x) 120px;
  }

  /* ---------- Project details (sticky) ---------- */
  .side {
    position: sticky;
    top: var(--side-top);
    align-self: flex-start;
    flex: 0 0 auto;
    width: clamp(300px, 22vw, 617px);
    height: calc(100vh - var(--side-top));
    height: calc(100svh - var(--side-top));
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(24px, calc(100 * var(--u)), 100px) 0 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    font-family: var(--ui);
    letter-spacing: -0.01em;
  }
  .side::-webkit-scrollbar {
    display: none;
  }

  .projects {
    display: flex;
    gap: 9px;
  }
  .thumb {
    display: block;
    width: 69.3px;
    height: 79px;
    opacity: 0.2;
    transition: opacity 0.25s ease;
  }
  .thumb:hover,
  .thumb.current {
    opacity: 1;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details,
  .toc {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .details {
    gap: 42px;
  }
  .row,
  .toc {
    display: grid;
    grid-template-columns: minmax(0, 0.25fr) minmax(0, 1fr);
    gap: 16px;
    line-height: 1.36;
  }
  .toc {
    align-content: center;
  }
  dt,
  .toc__label {
    color: var(--muted);
    font-size: 14px;
  }
  dd {
    font-size: 16px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    letter-spacing: -0.03em;
  }
  .tag:not(:last-child)::after {
    content: '|';
    margin-left: 12px;
    color: var(--separator);
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 1.36em;
    letter-spacing: -0.03em;
  }

  /* Index: Barlow Condensed 24, grey; the section you're in turns black */
  .toc__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 24px;
    line-height: 0.98;
    letter-spacing: 0;
  }
  .toc__list a {
    color: #9f9f9f;
    transition: color 0.2s ease;
  }
  .toc__list a:hover,
  .toc__list a.active {
    color: var(--text);
  }

  /* Shorter windows: tighten the panel so everything fits */
  @media (min-width: 1024px) and (max-height: 1080px) {
    .details {
      gap: 18px;
    }
    .side {
      gap: 20px;
    }
    dd,
    .about {
      font-size: 14px;
    }
    .toc__list {
      gap: 10px;
      font-size: 20px;
    }
  }

  /* ---------- Content column ---------- */
  .main {
    flex: 1;
    min-width: 0;
    padding: clamp(24px, calc(100 * var(--u)), 100px) max(0px, calc((100vw - 1440px) * 0.207)) 0;
  }
  .column {
    /* 1 Figma px of the 1667px-wide column, for the blocks inside */
    --cu: calc(100cqw / 1667);
    container-type: inline-size;
    max-width: 1667px;
    margin: 0 auto;
  }

  /* ---------- Hero: photo with the title on it ---------- */
  .hero {
    --k: calc(100cqw / 1667);
    position: relative;
    aspect-ratio: 1667 / 1100;
    background: #1f2633;
  }
  .hero--drip,
  .hero--armada {
    aspect-ratio: 1667 / 1415;
  }
  /* the iPad runs off the bottom edge */
  .hero--armada {
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero--armada .hero__title {
    top: calc(272.5 * var(--k));
    width: calc(1023 * var(--k));
  }
  .hero--none::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 60%);
  }
  .hero__title {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc(321 * var(--k));
    width: calc(952 * var(--k));
    transform: translateX(-50%);
    font-size: calc(112 * var(--k));
    line-height: 0.78;
    letter-spacing: -0.03em;
    text-align: center;
    color: #fff;
    background: linear-gradient(165deg, #fff 30%, #d4e8fc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero--none .hero__title {
    top: calc(120 * var(--k));
    width: calc(1300 * var(--k));
  }

  /* ---------- Smaller screens: panel on top ---------- */
  @media (max-width: 1023px) {
    .study {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding-bottom: 80px;
    }
    .side {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      padding-bottom: 0;
    }
    .details {
      flex: none;
      gap: 16px;
    }
    .toc {
      display: none;
    }
    .main {
      padding: 0;
      margin: 0 calc(-1 * var(--pad-x));
    }
    .hero__title,
    .hero--armada .hero__title {
      font-size: calc(150 * var(--k));
      width: calc(1300 * var(--k));
    }
  }
</style>
