---
// Case study page (Figma "case study content" 217:2672).
// Left: the project details panel — it stays in view (sticky) while the case study scrolls.
// Right: a white column — hero with the title on it, then the MDX sections.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import DripHeroArt from '../../components/case-study/DripHeroArt.astro';
import ArmadaHeroArt from '../../components/case-study/ArmadaHeroArt.astro';
import { site } from '../../data/site';
import { slugify, sectionTitles } from '../../lib/slug';

export async function getStaticPaths() {
  const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return studies.map((study) => ({ params: { slug: study.id }, props: { study, studies } }));
}

const { study, studies } = Astro.props;
const { title, summary, hero, heroAlt, heroArt, client, year, tags, about } = study.data;
const { Content } = await render(study);

// Project switcher: this case study first, then the others
const projects = [study, ...studies.filter((s) => s.id !== study.id)];
const sections = sectionTitles(study.body).map((t) => ({ title: t, id: slugify(t) }));
---

<Base title={`${title} — ${site.name}`} description={summary.replace(/\s*\n\s*/g, ' ')}>
  <!-- Hold the page back until the script lets it in (see the reveal rules). Runs before paint. -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      d.classList.add('cs-motion', 'cs-wait');
      // if the page script never runs, show everything
      setTimeout(function () { if (!window.__csReveal) d.classList.remove('cs-motion', 'cs-wait'); }, 2500);
    })();
  </script>
  <Header active="case-study" solid />

  <div class="study">
    <!-- ===== Project details: sticks to the viewport ===== -->
    <aside class="side" aria-label="Project details" data-side>
      <nav class="projects" aria-label="Case studies">
        {projects.map((p) => (
          <a
            href={`/case-study/${p.id}/`}
            class:list={['thumb', { current: p.id === study.id }]}
            aria-current={p.id === study.id ? 'page' : undefined}
            title={p.data.title}
          >
            <Image src={p.data.cover} alt={p.data.title} widths={[70, 140]} sizes="70px" />
          </a>
        ))}
      </nav>

      <dl class="details">
        {year && (
          <div class="row">
            <dt>Year</dt>
            <dd>{year}</dd>
          </div>
        )}
        {client && (
          <div class="row">
            <dt>Client</dt>
            <dd>{client}</dd>
          </div>
        )}
        {tags.length > 0 && (
          <div class="row">
            <dt>Areas</dt>
            <dd class="tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </dd>
          </div>
        )}
        {about.length > 0 && (
          <div class="row">
            <dt>About</dt>
            <dd class="about">{about.map((p) => <p>{p}</p>)}</dd>
          </div>
        )}
      </dl>

      {sections.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc__label">Index</p>
          <ol class="toc__list display">
            {sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`} class:list={{ active: i === 0 }} data-toc={s.id}>{s.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>

    <!-- ===== Content ===== -->
    <main class="main">
      <div class="column">
        <header class:list={['hero', `hero--${heroArt}`]}>
          {hero && (
            <Image
              class="hero__bg"
              src={hero}
              alt={heroArt === 'none' ? heroAlt : ''}
              widths={[800, 1200, 1667, 2400].filter((w) => w <= hero.width * 1.5)}
              sizes="(max-width: 1023px) 100vw, 56vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <h1 class="hero__title display">{title}</h1>
          {heroArt === 'drip' && <DripHeroArt />}
          {heroArt === 'armada' && <ArmadaHeroArt />}
        </header>

        <Content />
      </div>
    </main>
  </div>
</Base>

<script>
  import '../../scripts/smooth';

  // Fade-ins: the header drops in, the hero and the panel fade up on load, and every block of
  // the case study fades up the first time it scrolls into view (once — never again after).
  const root = document.documentElement;
  if (root.classList.contains('cs-motion')) {
    (window as any).__csReveal = true;
    const blocks = [
      ...document.querySelectorAll<HTMLElement>(
        '.study > .side, .column > .hero, .chapter__title, .chapter__body > :not(.split), .split__visuals > *, .split__text > *, .chapter__after > :not(.split)'
      ),
    ];
    const io = new IntersectionObserver(
      (entries) => {
        let i = 0;
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          // blocks arriving together follow one another
          el.style.transitionDelay = `${Math.min(i++, 6) * 0.08}s`;
          el.classList.add('is-in');
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -6% 0px' }
    );
    requestAnimationFrame(() => {
      root.classList.remove('cs-wait');
      blocks.forEach((el) => io.observe(el));
    });
  }

  // The panel only scrolls on its own when it doesn't fit the window; otherwise the wheel
  // over it scrolls the page like anywhere else.
  const side = document.querySelector<HTMLElement>('[data-side]');
  if (side) {
    const check = () => side.toggleAttribute('data-lenis-prevent', side.scrollHeight > side.clientHeight + 1);
    check();
    new ResizeObserver(check).observe(side);
  }

  // Highlight the section you're reading in the Index
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const sections = [...document.querySelectorAll<HTMLElement>('[data-nav]')];
  if (links.size && sections.length) {
    const setActive = () => {
      const line = window.innerHeight * 0.35;
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      links.forEach((a, id) => a.classList.toggle('active', id === current.dataset.nav));
    };
    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
    window.addEventListener('resize', setActive);
  }
</script>

<style>
  .study {
    /* The panel sticks exactly where it starts — right under the header — so it never moves.
       --header-h is measured by the header itself (see Header.astro). */
    --side-top: var(--header-h, 109px);
    display: flex;
    align-items: flex-start;
    gap: 42px;
    padding: 0 var(--pad-x) 120px;
  }

  /* ---------- Fade-ins (see the script) ---------- */
  :global(html.cs-motion :is(.study > .side, .chapter__title, .chapter__body > :not(.split), .split__visuals > *, .split__text > *, .chapter__after > :not(.split))) {
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      translate 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(html.cs-motion :is(.study > .side, .chapter__title, .chapter__body > :not(.split), .split__visuals > *, .split__text > *, .chapter__after > :not(.split)):not(.is-in)) {
    opacity: 0;
    translate: 0 28px;
  }
  :global(html.cs-motion .column > .hero) {
    transition:
      opacity 1s ease,
      scale 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(html.cs-motion .column > .hero:not(.is-in)) {
    opacity: 0;
    scale: 1.03;
  }

  /* ---------- Project details (sticky) ---------- */
  .side {
    position: sticky;
    top: var(--side-top);
    align-self: flex-start;
    flex: 0 0 auto;
    width: clamp(300px, 22vw, 617px);
    height: calc(100vh - var(--side-top));
    height: calc(100svh - var(--side-top));
    display: flex;
    flex-direction: column;
    /* everything scales with the window height so the panel fits without scrolling;
       it only scrolls inside itself on very short windows */
    gap: clamp(12px, 1.8vh, 28px);
    padding: clamp(12px, 2.4vh, 48px) 0 clamp(12px, 2vh, 24px);
    overflow-y: auto;
    scrollbar-width: none;
    font-family: var(--ui);
    letter-spacing: -0.01em;
  }
  .side::-webkit-scrollbar {
    display: none;
  }

  .projects {
    display: flex;
    gap: 9px;
  }
  .thumb {
    display: block;
    width: 69.3px;
    height: 79px;
    opacity: 0.2;
    transition: opacity 0.25s ease;
  }
  .thumb:hover,
  .thumb.current {
    opacity: 1;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details,
  .toc {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .details {
    gap: clamp(10px, 1.7vh, 42px);
  }
  .row,
  .toc {
    display: grid;
    grid-template-columns: minmax(0, 0.25fr) minmax(0, 1fr);
    gap: 16px;
    line-height: 1.32;
  }
  .toc {
    align-content: center;
  }
  dt,
  .toc__label {
    color: var(--muted);
    font-size: clamp(12px, 1.5vh, 14px);
  }
  dd {
    font-size: clamp(13px, 1.6vh, 16px);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    letter-spacing: -0.03em;
  }
  .tag:not(:last-child)::after {
    content: '|';
    margin-left: 12px;
    color: var(--separator);
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    letter-spacing: -0.03em;
  }

  /* Index: Barlow Condensed 24, grey; the section you're in turns black */
  .toc__list {
    display: flex;
    flex-direction: column;
    gap: clamp(5px, 1vh, 16px);
    font-size: clamp(17px, 2.3vh, 24px);
    line-height: 1;
    letter-spacing: 0;
  }
  .toc__list a {
    color: #9f9f9f;
    transition: color 0.2s ease;
  }
  .toc__list a:hover,
  .toc__list a.active {
    color: var(--text);
  }

  /* ---------- Content column ---------- */
  .main {
    flex: 1;
    min-width: 0;
    padding: clamp(24px, calc(100 * var(--u)), 100px) max(0px, calc((100vw - 1440px) * 0.207)) 0;
  }
  .column {
    /* 1 Figma px of the 1667px-wide column, for the blocks inside */
    --cu: calc(100cqw / 1667);
    container-type: inline-size;
    max-width: 1667px;
    margin: 0 auto;
  }

  /* ---------- Hero: photo with the title on it ---------- */
  .hero {
    --k: calc(100cqw / 1667);
    position: relative;
    aspect-ratio: 1667 / 1100;
    background: #1f2633;
  }
  .hero--drip,
  .hero--armada {
    aspect-ratio: 1667 / 1415;
  }
  /* the iPad runs off the bottom edge */
  .hero--armada {
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero--armada .hero__title {
    top: calc(272.5 * var(--k));
    width: calc(1023 * var(--k));
  }
  .hero--none::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 60%);
  }
  .hero__title {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc(321 * var(--k));
    width: calc(952 * var(--k));
    transform: translateX(-50%);
    font-size: calc(112 * var(--k));
    line-height: 0.78;
    letter-spacing: -0.03em;
    text-align: center;
    color: #fff;
    background: linear-gradient(165deg, #fff 30%, #d4e8fc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero--none .hero__title {
    top: calc(120 * var(--k));
    width: calc(1300 * var(--k));
  }

  /* ---------- Smaller screens: panel on top ---------- */
  @media (max-width: 1023px) {
    .study {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding-bottom: 80px;
    }
    .side {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      padding-bottom: 0;
    }
    .details {
      flex: none;
      gap: 16px;
    }
    .toc {
      display: none;
    }
    .main {
      padding: 0;
      margin: 0 calc(-1 * var(--pad-x));
    }
    .hero__title,
    .hero--armada .hero__title {
      font-size: calc(150 * var(--k));
      width: calc(1300 * var(--k));
    }
  }
</style>
